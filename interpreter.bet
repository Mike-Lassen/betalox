ORIGIN '~beta/newmps/astlevel';
INCLUDE 'grammar/loxcfl';
INCLUDE 'grammar/loxgram';
INCLUDE '~beta/basiclib/numberio';
INCLUDE '~beta/basiclib/math';
INCLUDE '~beta/sysutils/time';
INCLUDE '~beta/containers/dictionary';
INCLUDE '~beta/containers/seqContainers';
INCLUDE '~beta/sysutils/objinterface';

-- lib: attributes --
Interpreter: AstInterface
  (# loxcfl: @lox;
     gram: @grammar;
     trace: @boolean;

     dumpAst:
       (# node: ^AST;
       enter node[]
       do (1, screen[], loxcfl[])->node.dump;
       #);

     ArgumentList: Deque
       (# Element:: LoxValue;
       #);
     LoxValue:
       (# dump:<
            (# output: ^Stream;
            enter output[]
            do INNER
            #);
          isNil:< booleanValue;
          isNumber:< booleanValue;
          asNumber:<
            (# value: @real
            do INNER
            exit value
            #);
          isBoolean:< booleanValue;
          asBoolean:<
            (# value: @boolean;
            do INNER
            exit value
            #);
          isString:< booleanValue;
          asString:<
            (# value: ^Text;
            do INNER
            exit value[]
            #);
          isCallable:< booleanValue;
          asCallable:<
            (# callable: ^LoxCallable;
            do INNER;
            exit callable[]
            #);
          isClass:< booleanValue;
          asClass:<
            (# value: ^LoxClass;
            do INNER
            exit value[]
            #);
          isTruthy:< booleanValue;
       #);
     LoxNumber: LoxValue
       (# value: @real;
          dump:: 
            (# 
            do value->output.putReal;
            #);
          isNumber:: trueValue;
          isInteger:
            (# result: @boolean;
            do (if (value -> floor) = value then
                   true -> result;
               if);
            exit result
            #);
          asNumber:: 
            (# 
            do THIS(LoxNumber).value->value
            #);
          asString:: 
            (# 
            do &Text[]->value[];
               (if isInteger then
                   THIS(LoxNumber).value->value.putInt;
               else
                   THIS(LoxNumber).value->value.putReal;
               if)
               
            #);
          isTruthy:: trueValue;
       enter value
       exit value
       #);
     LoxBoolean: LoxValue
       (# value: @boolean;
          dump:: 
            (# 
            do (if value then
                   'true'->screen.putText;
                else
                   'false'->screen.putText;
               if)
            #);
          isBoolean:: trueValue;
          asBoolean:: 
            (# 
            do THIS(LoxBoolean).value->value;
            #);
          asString:: 
            (# 
            do (if THIS(LoxBoolean).value then
                   'true'->value[];
                else
                   'false'->value[];
               if);
            #);
          isTruthy:: 
            (# 
            do THIS(LoxBoolean).value->value;
            #);
       #);
     LoxString: LoxValue
       (# value: ^Text;
          isString:: trueValue;
          asString:: 
            (# 
            do THIS(LoxString).value[]->value[];
            #);
          dump:: 
            (# 
            do value[]->output.putText;
            #);
          isTruthy:: trueValue;
       #);
     LoxNil: @LoxValue
       (# isNil:: trueValue;
          isTruthy:: falseValue;
          asString:: 
            (# 
            do 'nil'->value[];
            #);
          dump:: 
            (# 
            do 'nil'->output.putText;
            #);
       #);
     LoxCallable: LoxValue
       (# isNil:: falseValue;
          isTruthy:: trueValue;
          isCallable:: trueValue;
          asCallable:: 
            (# 
            do THIS(LoxCallable)[]->callable[]
            #);
          arity:< integerValue;
          call:<
            (# arguments: ^ArgumentList;
               result: ^LoxValue;
            enter arguments[]
            do INNER
            exit result[]
            #);
       #);
     LoxFunction: LoxCallable
       (# name: ^Text;
          closure: ^Environment;
          parameters: ^loxcfl.Parameters;
          block: ^loxcfl.Block;
          arity:: 
            (# 
            do parameters.noOfSons->value
            #);
          call:: 
            (# env: ^Environment;
            do &Environment[]->env[];
               closure[]->env.init;
               parameters.newScan
                 (# decl: ^NameDecl;
                    val: ^LoxValue;
                 do current.getNameDecl->decl[];
                    arguments.removeFront->val[];
                    (decl.getText, val[])->env.define;
                 #);
               executing:
                 (# 
                 do (env[], block[])
                      ->InterpretStatement
                        (# onReturn:: 
                             (# 
                             do value[]->result[];
                                leave executing;
                             #);
                        #);
                    LoxNil[]->result[];
                 #);
            #);
          asString:: 
            (# 
            do '<fun '->value[];
               name[]->value.putText;
               '>'->value.putText;
            #);
       #);
     LoxClass: LoxCallable
       (# 
          name: ^Text;
          asString::
            (#
            do name[] -> value[];
            #);
          isClass:: trueValue;
          asClass::
            (# do THIS(LoxClass)[] -> value[] #);
          call::
            (# instance: ^LoxInstance;
            do &LoxInstance[] -> instance[];
               THIS(LoxClass)[] -> instance.class[];
               instance[] -> result[];
            #);  
       #);
     LoxInstance: LoxValue
       (# class: ^LoxClass;
          asString::
            (#
            do &Text[] -> value[];
               class.name[] -> value.putText;
               ' instance' -> value.putText;
            #);
       #);
     NativeFunction: LoxCallable
       (# asString:: 
            (# 
            do '<native '->value[];
               THIS(NativeFunction)[]->getPatternName->value.putText;
               '>'->value.putText;
            #);
       #);
     Clock: NativeFunction
       (# arity:: 
            (# 
            do 0->value
            #);
          call:: 
            (# number: @LoxNumber;
            do cpuTime->number.value;
               number[]->result[];
            #);
       #);
     TextKeyDictionary: dictionary
       (# key:: Text;
          hashFunction:: 
            (# 
            do k.scanAll
                 (# 
                 do 131*value+ch->value;
                 #);
               (if value < 0 then
                   - value->value;
               if);
            #);
          keyEqual:: 
            (# 
            do left[]->right.equal->value
            #);
       #);
     ValueDictionary: TextKeyDictionary
       (# element:: LoxValue;
       #);
     Environment:
       (# values: @ValueDictionary;
          enclosing: ^Environment;
          init:
            (# 
            enter enclosing[]
            do values.init;
            #);
          isDefined:
            (# name: ^Text;
               result: @boolean;
            enter name[]
            do (name[]->values.lookup) <> none->result;
            exit result
            #);
          define:
            (# name: ^Text;
               value: ^LoxValue;
               ok: @boolean;
            enter (name[], value[])
            do (if not (name[]->isDefined) then
                   (name[], value[])->values.associate;
                   true->ok;
               if);
            exit ok
            #);
          get:
            (# name: ^Text;
               value: ^LoxValue;
            enter name[]
            do name[]->values.lookup->value[];
               (if (value[] = none) and (enclosing[] <> none) then
                   name[]->enclosing.get->value[];
               if)
            exit value[]
            #);
          getAt:
            (# name: ^Text;
               level: @integer;
               value: ^LoxValue;
               current: ^Environment;
            enter (name[], level)
            do THIS(Environment)[] -> current[];
               (for level repeat
                   current.enclosing[] -> current[];
               for);
               name[] -> current.values.lookup -> value[];
            exit value[]
            #);  
          assign:
            (# name: ^Text;
               value: ^LoxValue;
               ok: @boolean;
            enter (name[], value[])
            do (if name[]->isDefined then
                   (name[], value[])->values.associate;
                   true->ok;
                else
                   (if enclosing[] <> none then
                       (name[], value[])->enclosing.assign->ok;
                   if);
               if);
            exit ok
            #);
          display:
            (# 
            do values.scanAssociations
                 (# 
                 do k[]->screen.putText;
                    ': '->screen.putText;
                    e.asString->screen.putLine;
                 #);
               (if enclosing[] <> none then
                   '-- ENCLOSING -- '->screen.putLine;
                   enclosing.display;
               if);
            #);
       #);
     globals: ^Environment;
     interpretFile:
       (# name: ^Text;
          group: ^FragmentGroup;
       enter name[]
       do (name[], screen[])->TOP.open->group[];
          (if group[] <> none then
              (if trace then
                  'Executing group '->screen.putLine;
                  '  shortName: ' ->  screen.putText;
                  group.shortName -> screen.putLine;
                  '  textFileName: ' ->  screen.putText;
                  group.textFileName->screen.putLine;
                  '  diskFileName: ' ->  screen.putText;
                  group.diskFileName->screen.putLine;
                  '  fullName: ' ->  screen.putText;
                  group.fullName->screen.putLine;
                   '  name: ' ->  screen.putText;
                  group.name->screen.putLine;
              if);
              group.scan
                (# form: ^FragmentForm;
                do current[]->form[];
                   (if trace then
                       'Executing fragment '->screen.putText;
                       current.name->screen.putLine;
                       (1, screen[], loxcfl[])->form.root.dump;
                       screen.newline;
                       screen.newline;
                   if);
                   interpreting:
                   (globals[], form.root[])->InterpretProgram
                     (# semanticError::
                          (#
                          do screen.newline;
                             '=== Semantic Error ===' -> screen.putLine;
                             node[] -> dumpAst;
                             screen.newline;
                             '*** ' -> screen.putText;
                             message[] -> screen.putLine;
                             '---- char positions: ' -> screen.putText;
                             node.start -> screen.putInt;
                             ', ' -> screen.putText;
                             node.end -> screen.putInt;
                             screen.newline;
                             'Execution stopped because of semantic error' -> screen.putLine;
                             leave interpreting;
                          #);
                        runtimeError::
                          (#
                          do screen.newline;
                             '=== Runtime Error ===' -> screen.putLine;
                             node[] -> dumpAst;
                             screen.newline;
                             '*** ' -> screen.putText;
                             message[] -> screen.putLine;
                             '---- char positions: ' -> screen.putText;
                             node.start -> screen.putInt;
                             ', ' -> screen.putText;
                             node.end -> screen.putInt;
                             screen.newline;
                             'Execution stopped because of runtime error' -> screen.putLine;
                             leave interpreting;
                          #);  
                     #);
                #);
           else
              'Unable to open '->screen.putText;
              name[]->screen.putLine;
          if);
       #);
     Scope:
       (# enclosing: ^Scope;
          declarations: @TextKeyDictionary
            (# element:: Declaration
            #);
          init:
            (# 
            enter enclosing[]
            do declarations.init;
            #);
          declare:
            (# name: ^Text;
               decl: ^Declaration;
            enter (name[], decl[])
            do (name[], decl[])->declarations.associate;
            #);
          resolve:
            (# level: @integer;
               var: ^loxcfl.Variable;
               nameApl: ^NameAppl;
               decl: ^Declaration;
               ok: @boolean;
            enter (var[], level)
            do var.getNameAppl->nameApl[];
               nameApl.getText->declarations.lookup->decl[];
               (if decl[] <> none then
                   decl.name[]->var.declaration[];
                   level->var.level;
                   true->ok;
                else
                   (if enclosing[] <> none then
                       (var[], level+1)->enclosing.resolve->ok;
                    else
                       false->ok;
                   if)
               if)
            exit ok
            #);
       #);
     Declaration:
       (# name: ^loxcfl.Name;
          defined: @boolean;
          native: @boolean;
       #);
     Resolver:
       (# error:<
            (# node: ^AST;
               message: ^Text;
            enter (node[], message[])
            do INNER;
               message[]->screen.putLine;
               (failureTrace, message[]) -> stop;
            #);
          declare:
            (# name: ^loxcfl.Name;
               decl: ^Declaration;
               nameDcl: ^NameDecl;
            enter name[]
            do &Declaration[]->decl[];
               name[]->decl.name[];
               name.getNameDecl->nameDcl[];
               (nameDcl.getText, decl[])->top.declare;
            exit decl[]
            #);
          resolveLocal:
            (# var: ^loxcfl.Variable;
               ok: @boolean;
            enter var[]
            do (var[], 0)->top.resolve->ok;
            exit ok
            #);
          top: ^Scope;
          functionTypes: @
            (# main: (# exit 1 #);
               function: (# exit 2 #);
            #);
          currentFunction: @integer;

          beginScope:
            (# new: ^Scope;
            do &Scope[]->new[];
               top[]->new.init;
               new[]->top[];
            #);
          endScope:
            (# 
            do top.enclosing[]->top[];
            #);
          resolveProgram:
            (# program: ^loxcfl.Program;
            enter program[]
            do program.getStatements->resolveStatements;
            #);
          resolveStatements:
            (# statements: ^loxcfl.Statements;
            enter statements[]
            do statements.newScan
                 (# 
                 do current[]->resolveStatement;
                 #);
            #);
          resolveStatement:
            (# statement: ^loxcfl.Statement;
               visitor: @loxcfl.treeLevelVisitor
                 (# visit_Block:: 
                      (# 
                      do beginScope;
                         N.getStatements->resolveStatements;
                         endScope;
                      #);
                    visit_VarDecl:: 
                      (# decl: ^Declaration;
                         initializer: ^AST;
                         resolver: @loxcfl.treeLevelVisitor
                           (# visit_Initializer::
                                (#
                                do N.getExpression -> resolveExpression;
                                #);
                           #);
                      do N.getName->declare->decl[];
                         N.getInitializerOpt->initializer[];
                         resolver[] -> initializer.accept;
                         true->decl.defined;
                      #);
                    visit_ExprStmt:: 
                      (# 
                      do N.getExpression->resolveExpression;
                      #);
                    visit_PrintStmt:: 
                      (# 
                      do N.getExpression->resolveExpression;
                      #);
                    visit_FunDecl:: 
                      (# decl: ^Declaration;
                      do (N.getFunction, functionTypes.function)->resolveFunction;
                      #);
                    visit_ClassDecl::
                      (# decl: ^Declaration;
                      do N.getName->declare->decl[];
                         true -> decl.defined;
                      #);
                    visit_IfStmt:: 
                      (# resolver: @loxcfl.treeLevelVisitor
                           (# visit_ElsePart:: 
                                (# 
                                do N.getStatement->resolveStatement;
                                #);
                           #);
                      do N.getCondition->resolveExpression;
                         N.getStatement->resolveStatement;
                         resolver[]->(N.getElsePartOpt).accept;
                      #);
                    visit_WhileStmt:: 
                      (# 
                      do N.getCondition->resolveExpression;
                         N.getStatement->resolveStatement;
                      #);
                    visit_ReturnStmt:: 
                      (# expression: ^AST;
                      do (if currentFunction = functionTypes.main then
                           (N[], 'Cant return from top-level code.') -> error;
                         if);
                         N.getExpressionOpt->expression[];
                         (if expression## <= loxcfl.Expression## then
                             expression[]->resolveExpression;
                         if)
                      #);
                 #);
            enter statement[]
            do visitor[]->statement.accept;
            #);
          resolveFunction:
            (# function: ^loxcfl.Function;
               parameters: ^loxcfl.Parameters;
               type: @integer;
               enclosingType: @integer;
            enter (function[], type)
            do currentFunction -> enclosingType;
               type -> currentFunction;
               true->(function.getName->declare).defined;
               beginScope;
               function.getParameters->parameters[];
               parameters.newScan
                 (# 
                 do true->(current[]->declare).defined;
                 #);
               function.getBlock->resolveStatement;
               endScope;
               enclosingType -> currentFunction;
            #);
          resolveExpression:
            (# expression: ^loxcfl.Expression;
               visitor: @loxcfl.treeLevelVisitor
                 (# visit_Call:: 
                      (# arguments: ^loxcfl.Arguments;
                      do N.getCallee->resolveExpression;
                         N.getArguments->arguments[];
                         arguments.newScan
                           (# 
                           do current[]->resolveExpression;
                           #);
                      #);
                    visit_Assignment:: 
                      (# 
                      do N.getExpression->resolveExpression;
                         (if not (N.getVariable->resolveLocal) then
                             (N[], 'name not found')->error;
                         if);
                      #);
                    visit_Variable:: 
                      (# 
                      do (if not (N[]->resolveLocal) then
                             (N[], 'name not found')->error;
                         if);
                      #);
                    visit_Addition:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_Subtraction:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_Multiplication:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_Division:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_Grouping:: 
                      (# 
                      do N.getEvaluation->resolveExpression;
                      #);
                    visit_Equals:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_NotEquals:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_Less:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_LessEqual:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_Greater:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_GreaterEqual:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_LogicAnd:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_LogicOr:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_Negation:: 
                      (# 
                      do N.getEvaluation->resolveExpression;
                      #);
                    visit_BoolNegation:: 
                      (# 
                      do N.getEvaluation->resolveExpression;
                      #);
                 #);
            enter expression[]
            do visitor[]->expression.accept;
            #);
       enter top[]
       do functionTypes.main -> currentFunction;
          INNER
       #);
     ProgramResolver: Resolver
       (# program: ^loxcfl.Program;
       enter program[]
       do program[]->resolveProgram;
       #);
     Interpret:
       (# env: ^Environment;
          pushEnv:
            (# new: ^Environment
            do &Environment[]->new[];
               env[]->new.init;
               new[]->env[];
            #);
          popEnv:
            (# 
            do env.enclosing[]->env[];
            #);
          runtimeError:<
            (# node: ^AST;
               message: ^Text;
            enter (node[], message[])
            do INNER;
               message[]->screen.putLine;
               stop;
            #);
          semanticError:<
            (# node: ^AST;
               message: ^Text;
            enter (node[], message[])
            do INNER;
               (failureTrace, message[]) -> stop;
            #);
          onReturn:<
            (# value: ^LoxValue;
            enter value[]
            do INNER
            #);
          assertNumber:
            (# value: ^LoxValue;
               node: ^AST;
            enter (value[], node[])
            do (if not value.isNumber then
                   (node[], 'not a number')->runtimeError;
               if);
            #);
          assertBoolean:
            (# value: ^LoxValue;
               node: ^AST;
            enter (value[], node[])
            do (if not value.isBoolean then
                   (node[], 'not a boolean')->runtimeError;
               if);
            #);
          assertNonZero:
            (# value: @integer;
               node: ^AST;
            enter (value, node[])
            do (if value = 0 then
                   (node[], 'evaluated to zero')->runtimeError;
               if);
            #);
          ExecuteStatements:
            (# statements: ^loxcfl.Statements;
            enter statements[]
            do statements.newScan
                 (# 
                 do current[]->ExecuteStatement;
                 #);
            #);
          ExecuteStatement:
            (# statement: ^loxcfl.Statement;
               visitor: @loxcfl.treeLevelVisitor
                 (# visit_ExprStmt:: 
                      (# result: ^LoxValue;
                      do N.getExpression->Evaluate->result[];
                      #);
                    visit_PrintStmt:: 
                      (# result: ^LoxValue;
                      do N.getExpression->Evaluate->result[];
                         result.asString->screen.putText;
                      #);
                    visit_NewlineStmt:: 
                      (# 
                      do screen.newline;
                      #);
                    visit_VarDecl:: 
                      (# name: ^loxcfl.Name;
                         decl: ^NameDecl;
                         initializer: ^AST;
                         initialValue: ^LoxValue;
                         evaluator: @loxcfl.treeLevelVisitor
                           (# visit_Initializer:: 
                                (# 
                                do N.getExpression->Evaluate->initialValue[]
                                #);
                           #);
                      do N.getName->name[];
                         name.getNameDecl->decl[];
                         LoxNil[]->initialValue[];
                         N.getInitializerOpt->initializer[];
                         evaluator[]->initializer.accept;
                         (if not ((decl.getText, initialValue[])->env.define) then
                             (N[], 'variable already defined')->runtimeError;
                         if);
                      #);
                    visit_FunDecl:: 
                      (# function: ^loxcfl.Function;
                         name: ^loxcfl.Name;
                         decl: ^NameDecl;
                         theLoxFunction: ^LoxFunction;
                      do N.getFunction->function[];
                         function.getName->name[];
                         name.getNameDecl->decl[];
                         &LoxFunction[]->theLoxFunction[];
                         decl.getText->theLoxFunction.name[];
                         env[]->theLoxFunction.closure[];
                         function.getParameters->theLoxFunction.parameters[];
                         function.getBlock->theLoxFunction.block[];
                         (decl.getText, theLoxFunction[])->env.define;
                      #);
                    visit_ClassDecl::
                      (# name: ^loxcfl.Name;
                         decl: ^NameDecl;
                         value: ^LoxClass;
                      do N.getName->name[];
                         name.getNameDecl->decl[];
                         &LoxClass[] -> value[];
                         decl.getText -> value.name[];
                         (if not ((decl.getText, value[])->env.define) then
                             (N[], 'name already defined')->runtimeError;
                         if);
                      #);
                    visit_Block:: 
                      (# 
                      do pushEnv;
                         N.getStatements->ExecuteStatements;
                         popEnv;
                      #);
                    visit_IfStmt:: 
                      (# condition: ^LoxValue;
                         executor: @loxcfl.treeLevelVisitor
                           (# visit_ElsePart:: 
                                (# 
                                do N.getStatement->ExecuteStatement;
                                #);
                           #);
                      do N.getCondition->Evaluate->condition[];
                         (if condition.isTruthy then
                             N.getStatement->ExecuteStatement;
                          else
                             executor[]->(N.getElsePartOpt).accept;
                         if);
                      #);
                    visit_WhileStmt:: 
                      (# 
                      do loop:
                           (# condition: ^LoxValue;
                           do N.getCondition->Evaluate->condition[];
                              (if condition.isTruthy then
                                  N.getStatement->ExecuteStatement;
                                  restart loop;
                              if);
                           #);
                      #);
                    visit_ReturnStmt:: 
                      (# expression: ^AST;
                      do N.getExpressionOpt->expression[];
                         (if expression## <= loxcfl.Expression## then
                             expression[]->Evaluate->onReturn;
                          else
                             LoxNil[]->onReturn;
                         if);
                      #);
                 #);
            enter statement[]
            do visitor[]->statement.accept;
            #);
          Evaluate:
            (# expression: ^loxcfl.Expression;
               result: ^LoxValue;
               visitor: @loxcfl.treeLevelVisitor
                 (# Operation:
                      (# Type:< LoxValue;
                         result: ^Type;
                      do &Type[]->result[];
                         INNER;
                      exit result[]
                      #);
                    BinaryOperands: Operation
                      (# leftSide: ^loxcfl.Expression;
                         rightSide: ^loxcfl.Expression;
                         left: ^LoxValue;
                         right: ^LoxValue;
                      enter (leftSide[], rightSide[])
                      do leftSide[]->Evaluate->left[];
                         rightSide[]->Evaluate->right[];
                         (left[], leftSide[])->assertNumber;
                         (right[], rightSide[])->assertNumber;
                         INNER;
                      #);
                    BinaryMath: BinaryOperands
                      (# Type:: LoxNumber;
                      do INNER;
                      #);
                    Add: BinaryMath
                      (# 
                      do left.asNumber+right.asNumber->result.value
                      #);
                    Subtract: BinaryMath
                      (# 
                      do left.asNumber-right.asNumber->result.value
                      #);
                    Multiply: BinaryMath
                      (# 
                      do left.asNumber*right.asNumber->result.value
                      #);
                    Divide: BinaryMath
                      (# 
                      do (right.asNumber, rightSide[])->assertNonZero;
                         left.asNumber / right.asNumber->result.value;
                      #);
                    Comparison: BinaryOperands
                      (# Type:: LoxBoolean;
                      do INNER;
                      #);
                    Less: Comparison
                      (# 
                      do left.asNumber < right.asNumber->result.value;
                      #);
                    LessEqual: Comparison
                      (# 
                      do left.asNumber <= right.asNumber->result.value;
                      #);
                    Greater: Comparison
                      (# 
                      do left.asNumber > right.asNumber->result.value;
                      #);
                    GreaterEqual: Comparison
                      (# 
                      do left.asNumber >= right.asNumber->result.value;
                      #);
                    Equal: Comparison
                      (# 
                      do left.asNumber = right.asNumber->result.value;
                      #);
                    NotEqual: Comparison
                      (# 
                      do left.asNumber <> right.asNumber->result.value;
                      #);
                    AndOperation: Operation
                      (# Type:: LoxBoolean;
                         leftSide: ^loxcfl.Expression;
                         rightSide: ^loxcfl.Expression;
                         left: ^LoxValue;
                         right: ^LoxValue;
                      enter (leftSide[], rightSide[])
                      do leftSide[]->Evaluate->left[];
                         (if left.isTruthy then
                             rightSide[]->Evaluate->right[];
                             right.isTruthy->result.value;
                          else
                             false->result.value;
                         if);
                      #);
                    OrOperation: Operation
                      (# leftSide: ^loxcfl.Expression;
                         rightSide: ^loxcfl.Expression;
                         left: ^LoxValue;
                         right: ^LoxValue;
                      enter (leftSide[], rightSide[])
                      do leftSide[]->Evaluate->left[];
                         (if left.isTruthy then
                             left[]->result[];
                             leave OrOperation;
                         if);
                         rightSide[]->Evaluate->right[];
                         (if right.isTruthy then
                             right[]->result[];
                             leave OrOperation;
                         if);
                         &LoxBoolean[]->result[];
                      #);
                    NegateOperation: Operation
                      (# Type:: LoxNumber;
                         theExpression: ^loxcfl.Expression;
                         value: ^LoxValue;
                      enter theExpression[]
                      do theExpression[]->Evaluate->value[];
                         (value[], theExpression[])->assertNumber;
                         - value.asNumber->result.value;
                      #);
                    BoolNegateOperation: Operation
                      (# Type:: LoxBoolean;
                         theExpression: ^loxcfl.Expression;
                         value: ^LoxValue;
                      enter theExpression[]
                      do theExpression[]->Evaluate->value[];
                         not value.isTruthy->result.value;
                      #);
                    visit_Call:: 
                      (# value: ^LoxValue;
                         callable: ^LoxCallable;
                         args: ^ArgumentList;
                         arguments: ^loxcfl.Arguments;
                      do N.getCallee->Evaluate->value[];
                         (if value.isCallable then
                             value.asCallable->callable[];
                             &ArgumentList[]->args[];
                             N.getArguments->arguments[];
                             arguments.newScan
                               (# 
                               do current[]->Evaluate->args.insertBack;
                               #);
                             (if args.size <> callable.arity then
                                 (N[], 'arity error')->runtimeError;
                             if);
                             args[]->callable.call->result[];
                         if);
                      #);
                    visit_Assignment:: 
                      (# name: ^loxcfl.Variable;
                         appl: ^NameAppl;
                      do N.getVariable->name[];
                         name.getNameAppl->appl[];
                         N.getExpression->Evaluate->result[];
                         (if not ((appl.getText, result[])->env.assign) then
                             (N[], 'variable does not exist')->runtimeError;
                         if);
                      #);
                    visit_Variable:: 
                      (# appl: ^NameAppl;
                      do N.getNameAppl->appl[];
                         (appl.getText, N.level)->env.getAt->result[];
                         (if result[] = none then
                             (N[], 'variable does not exist')->runtimeError;
                         if);
                      #);
                    visit_Number:: 
                      (# input: ^Text;
                         theNumber: @LoxNumber;
                         theConst: ^Const;
                      do N.getConst->theConst[];
                         theConst.getText->input[];
                         input.reset;
                         input.getNumber
                           (# integerValue:: 
                                (# 
                                do value->theNumber.value;
                                #);
                              basedValue:: 
                                (# 
                                do value->theNumber.value;
                                #);
                              realValue:: 
                                (# 
                                do value->theNumber.value;
                                #);
                           #);
                         theNumber[]->result[];
                      #);
                    visit_TrueExp:: 
                      (# theBoolean: @LoxBoolean;
                      do true->theBoolean.value;
                         theBoolean[]->result[];
                      #);
                    visit_FalseExp:: 
                      (# theBoolean: @LoxBoolean;
                      do false->theBoolean.value;
                         theBoolean[]->result[];
                      #);
                    visit_Addition:: 
                      (# left: ^LoxValue;
                         right: ^LoxValue;
                         stringResult: ^LoxString;
                         numberResult: ^LoxNumber;
                      do N.getLeftSide -> Evaluate -> left[];
                         (if true
                          // left.isNumber then
                             N.getRightSide -> Evaluate -> right[];
                             (right[], N[]) -> assertNumber;
                             &LoxNumber[] -> numberResult[];
                             left.asNumber + right.asNumber -> numberResult.value;
                             numberResult[] -> result[];
                          // left.isString then
                             N.getRightSide -> Evaluate -> right[];
                             &LoxString[] -> stringResult[];
                             &Text[] -> stringResult.value[];
                            left.asString -> stringResult.value.putText;
                            right.asString -> stringResult.value.putText;
                            stringResult[] -> result[];
                          else
                             (N[], 'number or string required') -> runtimeError;
                         if);
                      #);
                    visit_Subtraction:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Subtract->result[];
                      #);
                    visit_Multiplication:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Multiply->result[];
                      #);
                    visit_Division:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Divide->result[];
                      #);
                    visit_Grouping:: 
                      (# 
                      do N.getEvaluation->evaluate->result[];
                      #);
                    visit_Equals:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Equal->result[];
                      #);
                    visit_NotEquals:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->NotEqual->result[];
                      #);
                    visit_Less:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Less->result[];
                      #);
                    visit_LessEqual:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->LessEqual->result[];
                      #);
                    visit_Greater:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Greater->result[];
                      #);
                    visit_GreaterEqual:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->GreaterEqual->result[];
                      #);
                    visit_LogicAnd:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->AndOperation->result[];
                      #);
                    visit_LogicOr:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->OrOperation->result[];
                      #);
                    visit_Negation:: 
                      (# 
                      do N.getEvaluation->NegateOperation->result[];
                      #);
                    visit_BoolNegation:: 
                      (# 
                      do N.getEvaluation->BoolNegateOperation->result[];
                      #);
                    visit_Text:: 
                      (# str: ^String;
                         theLoxString: @LoxString;
                      do N.getString->str[];
                         str.getText->theLoxString.value[];
                         theLoxString[]->result[];
                      #);
                    visit_NilExp:: 
                      (# 
                      do LoxNil[]->result[];
                      #);
                 #);
            enter expression[]
            do visitor[]->expression.accept;
            exit result[]
            #);
       enter env[]
       do INNER;
       #);
     InterpretExpression: Interpret
       (# expression: ^loxcfl.Expression;
          result: ^LoxValue;
       enter expression[]
       do expression[]->Evaluate->result[];
       exit result[]
       #);
     InterpretProgram: Interpret
       (# program: ^loxcfl.Program;
          globalScope: @Scope;
          clockDecl: @Declaration;
       enter program[]
       do true->clockDecl.defined;
          true->clockDecl.native;
          ('clock', clockDecl[])->globalScope.declare;
          (globalScope[], program[])->ProgramResolver
            (# error::
                 (#
                 do (node[], message[]) -> semanticError;
                 #);
            #);
          program.getStatements->ExecuteStatements;
       #);
     InterpretStatement: Interpret
       (# statement: ^loxcfl.Statement;
       enter statement[]
       do statement[]->ExecuteStatement;
       #)
  do 'grammar/lox-parser'->loxcfl.init;
     &Environment[]->globals[];
     globals.init;
     ('clock', &Clock[])->globals.define;
     INNER;
  #);

