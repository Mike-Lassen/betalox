ORIGIN 'interpreter';

-- program: descriptor --
Interpreter
  (# evaluationLoop: cycle
       (# frag: ^FragmentForm;
          line: ^Text;
          root: ^loxcfl.Expression;
          result: ^LoxValue;
       do &FragmentForm[]->frag[];
          frag.init;
          '> '->screen.putText;
          keyboard.getLine->line[];
          line.reset;
          (gram.Expression, line[], screen[], frag[])->loxcfl.parser.parse->root[];
          (if root[] <> none then
              (1, screen[], loxcfl[])->root.dump;
              screen.newline;
              eval:
                (# 
                do (globals[], root[])
                     ->InterpretExpression
                       (# runtimeError:: 
                            (# 
                            do 'error at '->screen.putText;
                               node.start->screen.putInt;
                               ' - '->screen.putText;
                               node.end->screen.putInt;
                               ': '->screen.putText;
                               message[]->screen.putLine;
                               leave eval;
                            #);
                       #)->result[];
                   (if result[] <> none then
                       screen[]->result.dump;
                       screen.newline;
                   if);
                #);
           else
              'Parse-errors:'->screen.putLine;
              line.newline;
              line.reset;
              (line[], screen[])->loxcfl.parser.errorReport;
          if);
       #);
    name: ^Text;
  do false -> trace;
     (if noOfArguments > 1 then
        2 -> arguments -> name[];
     if);
     (if name[] <> NONE then
         name[] -> interpretFile;
      else
         evaluationLoop
     if);
  #)

