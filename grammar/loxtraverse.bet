ORIGIN 'loxcfl';
BODY 'loxtraversebody';

(* Skeleton file for traversal of ASTs based on
 * grammar 'lox'.
 * Take a copy of this file and fill out the do-parts.
 * Do NOT edit this file directly as it will be overwritten
 * when the grammar is processed again.
 *)
--LIB: attributes--

lox_traverse: 
  (# ast: @astInterface (* An instance of the AST interface *);
     lox: @ast.lox;

     do_Program: (* list *)
       (# P: ^lox.Program
       enter P[]
       <<SLOT do_Program_body: DoPart>>
       #);
     do_Statement: (* alternation *)
       (# S: ^lox.Statement
       enter S[]
       <<SLOT do_Statement_body: DoPart>>
       #);
     do_VarDecl: (* cons *)
       (# V: ^lox.VarDecl
       enter V[]
       <<SLOT do_VarDecl_body: DoPart>>
       #);
     do_IntializerOpt: (* optional *)
       (# a: ^astinterface.ast;
       enter a[]
       <<SLOT do_IntializerOpt_body: DoPart>>
       #);
     do_Initializer: (* cons *)
       (# I: ^lox.Initializer
       enter I[]
       <<SLOT do_Initializer_body: DoPart>>
       #);
     do_ExprStmt: (* cons *)
       (# E: ^lox.ExprStmt
       enter E[]
       <<SLOT do_ExprStmt_body: DoPart>>
       #);
     do_PrintStmt: (* cons *)
       (# P: ^lox.PrintStmt
       enter P[]
       <<SLOT do_PrintStmt_body: DoPart>>
       #);
     do_Expression: (* alternation *)
       (# E: ^lox.Expression
       enter E[]
       <<SLOT do_Expression_body: DoPart>>
       #);
     do_Assignment: (* cons *)
       (# A: ^lox.Assignment
       enter A[]
       <<SLOT do_Assignment_body: DoPart>>
       #);
     do_Name: (* cons *)
       (# N: ^lox.Name
       enter N[]
       <<SLOT do_Name_body: DoPart>>
       #);
     do_Evaluation: (* alternation *)
       (# E: ^lox.Evaluation
       enter E[]
       <<SLOT do_Evaluation_body: DoPart>>
       #);
     do_LogicOr: (* cons *)
       (# L: ^lox.LogicOr
       enter L[]
       <<SLOT do_LogicOr_body: DoPart>>
       #);
     do_Equivalence: (* alternation *)
       (# E: ^lox.Equivalence
       enter E[]
       <<SLOT do_Equivalence_body: DoPart>>
       #);
     do_LogicAnd: (* cons *)
       (# L: ^lox.LogicAnd
       enter L[]
       <<SLOT do_LogicAnd_body: DoPart>>
       #);
     do_Equality: (* alternation *)
       (# E: ^lox.Equality
       enter E[]
       <<SLOT do_Equality_body: DoPart>>
       #);
     do_Equals: (* cons *)
       (# E: ^lox.Equals
       enter E[]
       <<SLOT do_Equals_body: DoPart>>
       #);
     do_NotEquals: (* cons *)
       (# N: ^lox.NotEquals
       enter N[]
       <<SLOT do_NotEquals_body: DoPart>>
       #);
     do_Comparison: (* alternation *)
       (# C: ^lox.Comparison
       enter C[]
       <<SLOT do_Comparison_body: DoPart>>
       #);
     do_Less: (* cons *)
       (# L: ^lox.Less
       enter L[]
       <<SLOT do_Less_body: DoPart>>
       #);
     do_LessEqual: (* cons *)
       (# L: ^lox.LessEqual
       enter L[]
       <<SLOT do_LessEqual_body: DoPart>>
       #);
     do_Greater: (* cons *)
       (# G: ^lox.Greater
       enter G[]
       <<SLOT do_Greater_body: DoPart>>
       #);
     do_GreaterEqual: (* cons *)
       (# G: ^lox.GreaterEqual
       enter G[]
       <<SLOT do_GreaterEqual_body: DoPart>>
       #);
     do_Term: (* alternation *)
       (# T: ^lox.Term
       enter T[]
       <<SLOT do_Term_body: DoPart>>
       #);
     do_Addition: (* cons *)
       (# A: ^lox.Addition
       enter A[]
       <<SLOT do_Addition_body: DoPart>>
       #);
     do_Subtraction: (* cons *)
       (# S: ^lox.Subtraction
       enter S[]
       <<SLOT do_Subtraction_body: DoPart>>
       #);
     do_Factor: (* alternation *)
       (# F: ^lox.Factor
       enter F[]
       <<SLOT do_Factor_body: DoPart>>
       #);
     do_Multiplication: (* cons *)
       (# M: ^lox.Multiplication
       enter M[]
       <<SLOT do_Multiplication_body: DoPart>>
       #);
     do_Division: (* cons *)
       (# D: ^lox.Division
       enter D[]
       <<SLOT do_Division_body: DoPart>>
       #);
     do_Unary: (* alternation *)
       (# U: ^lox.Unary
       enter U[]
       <<SLOT do_Unary_body: DoPart>>
       #);
     do_Negation: (* cons *)
       (# N: ^lox.Negation
       enter N[]
       <<SLOT do_Negation_body: DoPart>>
       #);
     do_BoolNegation: (* cons *)
       (# B: ^lox.BoolNegation
       enter B[]
       <<SLOT do_BoolNegation_body: DoPart>>
       #);
     do_Primary: (* alternation *)
       (# P: ^lox.Primary
       enter P[]
       <<SLOT do_Primary_body: DoPart>>
       #);
     do_Grouping: (* cons *)
       (# G: ^lox.Grouping
       enter G[]
       <<SLOT do_Grouping_body: DoPart>>
       #);
     do_BoolExp: (* alternation *)
       (# B: ^lox.BoolExp
       enter B[]
       <<SLOT do_BoolExp_body: DoPart>>
       #);
     do_TrueExp: (* cons *)
       (# T: ^lox.TrueExp
       enter T[]
       <<SLOT do_TrueExp_body: DoPart>>
       #);
     do_FalseExp: (* cons *)
       (# F: ^lox.FalseExp
       enter F[]
       <<SLOT do_FalseExp_body: DoPart>>
       #);
     do_NilExp: (* cons *)
       (# N: ^lox.NilExp
       enter N[]
       <<SLOT do_NilExp_body: DoPart>>
       #);
     do_Variable: (* cons *)
       (# V: ^lox.Variable
       enter V[]
       <<SLOT do_Variable_body: DoPart>>
       #);
     do_Number: (* cons *)
       (# N: ^lox.Number
       enter N[]
       <<SLOT do_Number_body: DoPart>>
       #);
     do_Text: (* cons *)
       (# T: ^lox.Text
       enter T[]
       <<SLOT do_Text_body: DoPart>>
       #);

     do_nameDecl: (* lexem *)
       (# n: ^astinterface.nameDecl;
          getText: (# exit n.getText #);
       enter n[] 
       do INNER;
       #);
     do_nameAppl: (* lexem *)
       (# n: ^astinterface.nameAppl;
          getText: (# exit n.getText #);
       enter n[] 
       do INNER;
       #);
     do_const: (* lexem *)
       (# c: ^astinterface.const;
          getText: (# exit c.getText #);
          getValue: (# exit c.getValue #);
       enter c[] 
       do INNER;
       #);
     do_string: (* lexem *)
       (# s: ^astinterface.string;
          getText: (# exit s.getText #);
       enter s[] 
       do INNER;
       #);
     init: (* Initialization of astLevel and parser *)
       (# 
       <<SLOT lox_init_body: DoPart>>
       #);
  #);
