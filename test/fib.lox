-- program : Program : lox --

fun fib(n) {
  if (n <= 1) 
    return n;
  return fib(n - 2) + fib(n - 1);
}

var i = 0;
while(i < 10) {
    print "fib(";
    print i;
    print ") = ";
    var before = clock();
    var value = fib(i);
    var after = clock();
    print value;
    print " - elapsed: ";
    print after - before;
    newline;
    i = i + 1;
}
