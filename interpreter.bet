ORIGIN '~beta/newmps/astlevel';
INCLUDE 'grammar/loxcfl';
INCLUDE 'grammar/loxgram';
INCLUDE '~beta/basiclib/numberio';
INCLUDE '~beta/containers/dictionary';

-- lib: attributes --
Interpreter: AstInterface
  (# loxcfl: @lox;
     gram: @grammar;
     LoxValue:
       (# dump:<
            (# output: ^Stream;
            enter output[]
            do INNER
            #);
          isNil:< booleanValue;  
          isNumber:< booleanValue;
          asNumber:<
            (# value: @real
            do INNER
            exit value
            #);
          isBoolean:< booleanValue;  
          asBoolean:<
            (# value: @boolean;
            do INNER
            exit value
            #);
          isString:< booleanValue;
          asString:<
            (# value: ^Text;
            do INNER
            exit value[]
            #);  
       #);
     LoxNumber: LoxValue
       (# value: @real;
          dump::
            (# 
            do value->output.putReal;
            #);
          isNumber:: trueValue;
          asNumber::
            (# 
            do THIS(LoxNumber).value->value
            #);
          asString::
            (#
            do &Text[] -> value[];
               THIS(LoxNumber).value -> value.putReal;
            #);
       enter value
       exit value
       #);
     LoxBoolean: LoxValue
       (# value: @boolean;
          dump::
            (# 
            do (if value then
                   'true'->screen.putText;
                else
                   'false'->screen.putText;
               if)
            #);
          isBoolean:: trueValue;
          asBoolean::
            (# 
            do THIS(LoxBoolean).value->value;
            #);
          asString::
            (#
            do (if THIS(LoxBoolean).value then
                   'true'->value[];
                else
                   'false'->value[];
               if);
            #); 
       #);
     LoxString: LoxValue
       (# value: ^Text;
          isString:: trueValue;
          asString::
            (#
            do THIS(LoxString).value[] -> value[];
            #);
          dump::
            (#
            do value[] -> output.putText;
            #);  
       #);
     LoxNil: @LoxValue
       (# isNil:: trueValue;
          asString::
            (#
            do 'nil' -> value[];
            #);
          dump::
            (#
            do 'nil' -> output.putText;
            #);  
       #);  
     ValueDictionary: dictionary
       (# key:: Text;
          element:: LoxValue;
          hashFunction::
            (# 
            do k.scanAll
                 (# 
                 do 131*value+ch->value;
                 #);
               (if value < 0 then
                   - value->value;
               if);
            #);
          keyEqual::
            (# 
            do left[]->right.equal->value;
            #);
       #);

     Environment:
       (# values: @ValueDictionary;
          enclosing: ^Environment;
          init:
            (#
            enter enclosing[]
            do values.init;
            #);
          isDefined:
            (# name: ^Text;
               result: @boolean;
            enter name[]
            do (name[] -> values.lookup) <> NONE -> result;
            exit result
            #);
          define:
            (# name: ^Text;
               value: ^LoxValue;
               ok: @boolean;
            enter (name[], value[])
            do (if NOT (name[] -> isDefined) then
                   (name[], value[]) -> values.associate;
                   true -> ok;
               if);
            exit ok   
            #);
          get:
            (# name: ^Text;
               value: ^LoxValue;
            enter name[]
            do name[] -> values.lookup -> value[];
               (if (value[] = NONE) AND (enclosing[] <> NONE) then
                   name[] -> enclosing.get -> value[];
               if)
            exit value[]   
            #);
          assign:
            (# name: ^Text;
               value: ^LoxValue;
               ok: @boolean;
            enter (name[], value[])
            do (if name[] -> isDefined then
                  (name[], value[]) -> values.associate;
                  true -> ok;
                else
                  (if enclosing[] <> NONE then
                      (name[], value[]) -> enclosing.assign -> ok;
                  if);  
               if);
            exit ok
            #);
       #);

     env: ^Environment;
     pushEnv:
       (# new: ^Environment
       do &Environment[] -> new[];
          env[] -> new.init;
          new[] -> env[];
       #);
     popEnv:
       (#
       do env.enclosing[] -> env[];
       #);

     interpretFile:
       (# name: ^Text;
          group: ^FragmentGroup;
       enter name[]
       do (name[], screen[]) -> TOP.open -> group[];
          (if group[] <> NONE then
              'Executing group ' -> screen.putText;
              group.textFileName -> screen.putLine;
              group.scan
                (# form: ^FragmentForm;
                do 'Executing fragment ' -> screen.putText;
                   current.name -> screen.putLine;
                   current[] -> form[];
                   (1, screen[], loxcfl[])->form.root.dump;
                   screen.newline;
                   screen.newline;
                   form.root[] -> InterpretProgram;
                #);
           else
              'Unable to open ' -> screen.putText;
              name[] -> screen.putLine;   
          if);
       #);
     Interpret:
       (# error:<
            (# node: ^AST;
               message: ^Text;
            enter (node[], message[])
            do INNER;
               message[]->screen.putLine;
               stop;
            #);
          ExecuteStatements:
            (# statements: ^loxcfl.Statements;
            enter statements[]
            do statements.newScan
                 (#
                 do current[] -> ExecuteStatement;
                 #);
            #);  
          ExecuteStatement:
            (# statement: ^loxcfl.Statement;
               visitor: @loxcfl.treeLevelVisitor
                 (# visit_ExprStmt::
                      (# result: ^LoxValue;
                      do N.getExpression -> Evaluate -> result[];
                      #);
                    visit_PrintStmt::
                      (# result: ^LoxValue;
                      do N.getExpression -> Evaluate -> result[];
                         result.asString -> screen.putLine;
                      #);
                    visit_VarDecl::
                      (# name: ^loxcfl.Name;
                         decl: ^NameDecl;
                         initializer: ^AST;
                         initialValue: ^LoxValue;
                         evaluator: @loxcfl.treeLevelVisitor
                           (# visit_Initializer::
                                (#
                                do N.getExpression -> Evaluate -> initialValue[]
                                #);
                           #);

                      do N.getName -> name[];
                         name.getNameDecl -> decl[];
                         LoxNil[] -> initialValue[];
                         N.getIntializerOpt -> initializer[];
                         evaluator[] -> initializer.accept;
                         (if NOT ((decl.getText, initialValue[]) -> env.define) then
                             (N[], 'variable already defined') -> error;
                         if);
                      #);
                    visit_Block::
                      (# 
                      do pushEnv;
                         N.getStatements -> ExecuteStatements;
                         popEnv;
                      #);  
                 #);
            enter statement[]
            do visitor[]->statement.accept;
            #);
          Evaluate:
            (# expression: ^loxcfl.Expression;
               result: ^LoxValue;
               visitor: @loxcfl.treeLevelVisitor
                 (# 
                    assertNumber:
                      (# value: ^LoxValue;
                         node: ^AST;
                      enter (value[], node[])
                      do (if NOT value.isNumber then
                             (node[], 'not a number')->error;
                         if);
                      #);
                    assertBoolean:
                      (# value: ^LoxValue;
                         node: ^AST;
                      enter (value[], node[])
                      do (if NOT value.isBoolean then
                             (node[], 'not a boolean')->error;
                         if);
                      #);
                    assertNonZero:
                      (# value: @integer;
                         node: ^AST;
                      enter (value, node[])
                      do (if value = 0 then
                             (node[], 'evaluated to zero')->error;
                         if);
                      #);
                    Operation:
                      (# Type:< LoxValue;
                         result: ^Type;
                      do &Type[]->result[];
                         INNER;
                      exit result[]
                      #);
                    BinaryOperands: Operation
                      (# leftSide: ^loxcfl.Expression;
                         rightSide: ^loxcfl.Expression;
                         left: ^LoxValue;
                         right: ^LoxValue;
                      enter (leftSide[], rightSide[])
                      do leftSide[]->Evaluate->left[];
                         rightSide[]->Evaluate->right[];
                         (left[], leftSide[])->assertNumber;
                         (right[], rightSide[])->assertNumber;
                         INNER;
                      #);
                    BinaryMath: BinaryOperands
                      (# Type:: LoxNumber;
                      do INNER;
                      #);
                    Add: BinaryMath
                      (# 
                      do left.asNumber+right.asNumber->result.value
                      #);
                    Subtract: BinaryMath
                      (# 
                      do left.asNumber-right.asNumber->result.value
                      #);
                    Multiply: BinaryMath
                      (# 
                      do left.asNumber*right.asNumber->result.value
                      #);
                    Divide: BinaryMath
                      (# 
                      do (right.asNumber, rightSide[])->assertNonZero;
                         left.asNumber / right.asNumber->result.value;
                      #);
                    Comparison: BinaryOperands
                      (# Type:: LoxBoolean;
                      do INNER;
                      #);
                    Less: Comparison
                      (# 
                      do left.asNumber < right.asNumber->result.value;
                      #);
                    LessEqual: Comparison
                      (# 
                      do left.asNumber <= right.asNumber->result.value;
                      #);
                    Greater: Comparison
                      (# 
                      do left.asNumber > right.asNumber->result.value;
                      #);
                    GreaterEqual: Comparison
                      (# 
                      do left.asNumber >= right.asNumber->result.value;
                      #);
                    Equal: Comparison
                      (# 
                      do left.asNumber = right.asNumber->result.value;
                      #);
                    NotEqual: Comparison
                      (# 
                      do left.asNumber <> right.asNumber->result.value;
                      #);
                    AndOperation: Operation
                      (# Type:: LoxBoolean;
                         leftSide: ^loxcfl.Expression;
                         rightSide: ^loxcfl.Expression;
                         left: ^LoxValue;
                         right: ^LoxValue;
                      enter (leftSide[], rightSide[])
                      do leftSide[]->Evaluate->left[];
                         (left[], leftSide[])->assertBoolean;
                         (if left.asBoolean then
                             rightSide[]->Evaluate->right[];
                             (right[], rightSide[])->assertBoolean;
                             right.asBoolean->result.value;
                          else
                             false->result.value;
                         if);
                      #);
                    OrOperation: Operation
                      (# Type:: LoxBoolean;
                         leftSide: ^loxcfl.Expression;
                         rightSide: ^loxcfl.Expression;
                         left: ^LoxValue;
                         right: ^LoxValue;
                      enter (leftSide[], rightSide[])
                      do leftSide[]->Evaluate->left[];
                         (left[], leftSide[])->assertBoolean;
                         (if not left.asBoolean then
                             rightSide[]->Evaluate->right[];
                             (right[], rightSide[])->assertBoolean;
                             right.asBoolean->result.value;
                          else
                             true->result.value;
                         if);
                      #);
                    NegateOperation: Operation
                      (# Type:: LoxNumber;
                         theExpression: ^loxcfl.Expression;
                         value: ^LoxValue;
                      enter theExpression[]
                      do theExpression[] -> Evaluate -> value[];
                         (value[], theExpression[]) -> assertNumber;
                         -value.asNumber -> result.value;
                      #);
                    BoolNegateOperation: Operation
                      (# Type:: LoxBoolean;
                         theExpression: ^loxcfl.Expression;
                         value: ^LoxValue;
                      enter theExpression[]
                      do theExpression[] -> Evaluate -> value[];
                         (value[], theExpression[]) -> assertBoolean;
                         NOT value.asBoolean -> result.value;
                      #);  
                    visit_Assignment::
                      (# name: ^loxcfl.Variable;
                         appl: ^NameAppl;
                      do N.getVariable -> name[];
                         name.getNameAppl -> appl[];
                         N.getExpression -> Evaluate -> result[];
                         (if NOT ((appl.getText, result[]) -> env.assign) then
                             (N[], 'variable does not exist') -> error;
                         if);
                      #);
                    visit_Variable::
                      (# appl: ^NameAppl;
                      do N.getNameAppl -> appl[];
                         appl.getText -> env.get -> result[];
                         (if result[] = NONE then
                             (N[], 'variable does not exist') -> error;
                         if);
                      #);
                    visit_Number::
                      (# input: ^Text;
                         theNumber: @LoxNumber;
                         theConst: ^Const;
                      do N.getConst->theConst[];
                         theConst.getText->input[];
                         input.reset;
                         input.getNumber
                           (# integerValue::
                                (# 
                                do value->theNumber.value;
                                #);
                              basedValue::
                                (# 
                                do value->theNumber.value;
                                #);
                              realValue::
                                (# 
                                do value->theNumber.value;
                                #);
                           #);
                         theNumber[]->result[];
                      #);
                    visit_TrueExp::
                      (# theBoolean: @LoxBoolean;
                      do true->theBoolean.value;
                         theBoolean[]->result[];
                      #);
                    visit_FalseExp::
                      (# theBoolean: @LoxBoolean;
                      do false->theBoolean.value;
                         theBoolean[]->result[];
                      #);
                    visit_Addition::
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Add->result[];
                      #);
                    visit_Subtraction::
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Subtract->result[];
                      #);
                    visit_Multiplication::
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Multiply->result[];
                      #);
                    visit_Division::
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Divide->result[];
                      #);
                    visit_Grouping::
                      (# 
                      do N.getEvaluation->evaluate->result[];
                      #);
                    visit_Equals::
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Equal->result[];
                      #);
                    visit_NotEquals::
                      (# 
                      do (N.getLeftSide, N.getRightSide)->NotEqual->result[];
                      #);
                    visit_Less::
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Less->result[];
                      #);
                    visit_LessEqual::
                      (# 
                      do (N.getLeftSide, N.getRightSide)->LessEqual->result[];
                      #);
                    visit_Greater::
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Greater->result[];
                      #);
                    visit_GreaterEqual::
                      (# 
                      do (N.getLeftSide, N.getRightSide)->GreaterEqual->result[];
                      #);
                    visit_LogicAnd::
                      (# 
                      do (N.getLeftSide, N.getRightSide)->AndOperation->result[];
                      #);
                    visit_LogicOr::
                      (# 
                      do (N.getLeftSide, N.getRightSide)->OrOperation->result[];
                      #);
                    visit_Negation::
                      (#
                      do N.getEvaluation -> NegateOperation -> result[];
                      #);
                    visit_BoolNegation::
                      (#
                      do N.getEvaluation -> BoolNegateOperation -> result[];
                      #);
                    visit_Text::
                      (# str: ^String;
                         theLoxString: @LoxString;
                      do N.getString -> str[];
                         str.getText -> theLoxString.value[];
                         theLoxString[] -> result[];
                      #);
                    visit_NilExp::
                      (#
                      do LoxNil[] -> result[];
                      #);  
                 #);
            enter expression[]
            do visitor[]->expression.accept;
            exit result[]
            #);
       do INNER;
       #);
     InterpretExpression: Interpret
       (# expression: ^loxcfl.Expression;
          result: ^LoxValue;
       enter expression[]
       do expression[]->Evaluate->result[];
       exit result[] 
       #);
     InterpretProgram: Interpret
       (# program: ^loxcfl.Program;
       enter program[]
       do program.getStatements -> ExecuteStatements;
       #);  
  do 'grammar/lox-parser'->loxcfl.init;
     &Environment[] -> env[];
     env.init;
     INNER;
  #);

