   GreaterEqual## -> genRefArray[24]##;
   2 -> kindArray[25]; 2 -> roomArray[25]; 0 -> sonArray[25]; 
   unExpanded## -> genRefArray[25]##;
   1 -> kindArray[26]; 0 -> roomArray[26]; 2 -> sonArray[26]; 
   Addition## -> genRefArray[26]##;
   1 -> kindArray[27]; 0 -> roomArray[27]; 2 -> sonArray[27]; 
   Subtraction## -> genRefArray[27]##;
   2 -> kindArray[28]; 2 -> roomArray[28]; 0 -> sonArray[28]; 
   unExpanded## -> genRefArray[28]##;
