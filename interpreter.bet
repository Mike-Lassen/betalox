ORIGIN '~beta/newmps/astlevel';
INCLUDE 'grammar/loxcfl';
INCLUDE 'grammar/loxgram';
INCLUDE '~beta/basiclib/numberio'

-- lib: attributes --
Interpreter: AstInterface
  (# loxcfl: @lox;
     gram: @grammar;

     
     loxValueTypes: @
       (# number: (# exit 1 #);
          string: (# exit 2 #);
          boolean: (# exit 3 #);
       #);
     LoxValue:
       (# type:<
            (# value: @integer
            do INNER
            exit value
            #);
          dump:<
            (# output: ^Stream;
            enter output[]
            do INNER
            #);
          asNumber:<
            (# value: @real
            do INNER
            exit value
            #);
       #);
     LoxNumber: LoxValue
       (# value: @real;
          type:: (# do loxValueTypes.number -> value #);
          dump::
            (#
            do value -> output.putReal;
            #);
          asNumber::
            (#
            do THIS(LoxNumber).value -> value
            #);  
       enter value
       exit value
       #);
     Evaluate:
       (# error:<
            (# node: ^AST;
               message: ^Text;
            enter (node[], message[])   
            do INNER;
               message[] -> screen.putLine;
               stop;
            #);
          expression: ^loxcfl.Expression;
          result: ^LoxValue;
          theVisitor: @loxcfl.treeLevelVisitor
            (# 
               assertValue:
                 (# value: ^LoxValue;
                    node: ^AST;
                 enter (value[], node[])
                 do (if value[] = NONE then
                        (node[], 'evaluated to nil') -> error;
                    if);
                 #);
               assertNumber:
                 (# value: ^LoxValue;
                    node: ^AST;
                 enter (value[], node[])
                 do (if value[] = NONE then
                        (node[], 'evaluated to nil') -> error;
                    else 
                        (if value.type <> loxValueTypes.number then
                            (node[], 'not a number') -> error;
                        if);
                    if);
                 #);
               assertNonZero:
                 (# value: @integer;
                    node: ^AST;
                 enter (value, node[])
                 do (if value = 0 then
                        (node[], 'evaluated to zero') -> error;
                    if);
                 #);

               Operation:
                 (# Type:< LoxValue;
                    result: ^Type;
                 do &Type[] -> result[];
                    INNER;
                 exit result[]
                 #);
               BinaryMath: Operation
                 (# Type:: LoxNumber;
                    leftSide: ^loxcfl.Expression;
                    rightSide: ^loxcfl.Expression;
                    left: ^LoxValue;
                    right: ^LoxValue;
                 enter (leftSide[], rightSide[])   
                 do leftSide[] -> Evaluate -> left[];
                    rightSide[] -> Evaluate -> right[];
                    (left[], leftSide[]) -> assertNumber;
                    (right[], rightSide[]) -> assertNumber;
                    INNER;
                 #);
               Add: BinaryMath 
                 (# 
                 do left.asNumber + right.asNumber -> result.value 
                 #);
               Subtract: BinaryMath
                 (# 
                 do left.asNumber - right.asNumber -> result.value 
                 #);
               Multiply: BinaryMath 
                 (# 
                 do left.asNumber * right.asNumber -> result.value 
                 #);
               Divide: BinaryMath 
                 (# 
                 do (right.asNumber, rightSide[]) -> assertNonZero;
                    left.asNumber / right.asNumber -> result.value;
                 #);
               visit_Number::
                 (# input: ^Text;
                    theNumber: @LoxNumber;
                    theConst: ^Const;
                 do N.getConst -> theConst[];
                    theConst.getText -> input[];
                    input.reset;
                    input.getNumber
                      (# integerValue::
                           (#
                           do value -> theNumber.value;
                           #);
                         basedValue::
                           (#
                           do value -> theNumber.value;
                           #);
                         realValue::
                           (#
                           do value -> theNumber.value;
                           #);  
                      #);
                    theNumber[] -> result[];
                 #);
               visit_Addition::
                 (# 
                 do (N.getLeftSide, N.getRightSide) -> Add -> result[];
                 #);
               visit_Subtraction::
                 (# 
                 do (N.getLeftSide, N.getRightSide) -> Subtract -> result[];
                 #);
               visit_Multiplication::
                 (# 
                 do (N.getLeftSide, N.getRightSide) -> Multiply -> result[];
                 #);
               visit_Division::
                 (# 
                 do (N.getLeftSide, N.getRightSide) -> Divide -> result[];
                 #);    
               visit_Grouping::
                 (#
                 do N.getEvaluation -> evaluate -> result[];
                 #);  
            #);
       enter expression[]
       do theVisitor[] -> expression.accept;
       exit result[]
       #);

  do 'grammar/lox-parser' -> loxcfl.init;
     INNER;
  #);
