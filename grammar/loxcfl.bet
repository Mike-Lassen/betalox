ORIGIN '~beta/newmps/astlevel'
--astInterfaceLib: attributes--

lox: TreeLevel
  (# <<SLOT loxAttributes:attributes>>;
     Program: cons
       (# getStatements: getson1(# #);
          putStatements: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Program)[] -> V.visit_Program #);
       exit 1
       #);
     Statements: list
       (# soncat::< Statement;
       exit 2
       #);
     Statement: cons
       (# 
       #);
     VarDecl: Statement
       (# getName: getson1(# #);
          putName: putson1(# #);
          getIntializerOpt: getson2(# #);
          putIntializerOpt: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(VarDecl)[] -> V.visit_VarDecl #);
       exit 4
       #);
     Initializer: cons
       (# getExpression: getson1(# #);
          putExpression: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Initializer)[] -> V.visit_Initializer #);
       exit 6
       #);
     ExprStmt: Statement
       (# getExpression: getson1(# #);
          putExpression: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(ExprStmt)[] -> V.visit_ExprStmt #);
       exit 7
       #);
     PrintStmt: Statement
       (# getExpression: getson1(# #);
          putExpression: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(PrintStmt)[] -> V.visit_PrintStmt #);
       exit 8
       #);
     Block: Statement
       (# getStatements: getson1(# #);
          putStatements: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Block)[] -> V.visit_Block #);
       exit 9
       #);
     Expression: cons
       (# 
       #);
     Assignment: Expression
       (# getVariable: getson1(# #);
          putVariable: putson1(# #);
          getExpression: getson2(# #);
          putExpression: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Assignment)[] -> V.visit_Assignment #);
       exit 11
       #);
     Name: cons
       (# getNameDecl: getson1(# #);
          putNameDecl: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Name)[] -> V.visit_Name #);
       exit 12
       #);
     Evaluation: Expression
       (# 
       #);
     LogicOr: Evaluation
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(LogicOr)[] -> V.visit_LogicOr #);
       exit 14
       #);
     Equivalence: Evaluation
       (# 
       #);
     LogicAnd: Equivalence
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(LogicAnd)[] -> V.visit_LogicAnd #);
       exit 16
       #);
     Equality: Equivalence
       (# 
       #);
     Equals: Equality
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Equals)[] -> V.visit_Equals #);
       exit 18
       #);
     NotEquals: Equality
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(NotEquals)[] -> V.visit_NotEquals #);
       exit 19
       #);
     Comparison: Equality
       (# 
       #);
     Less: Comparison
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Less)[] -> V.visit_Less #);
       exit 21
       #);
     LessEqual: Comparison
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(LessEqual)[] -> V.visit_LessEqual #);
       exit 22
       #);
     Greater: Comparison
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Greater)[] -> V.visit_Greater #);
       exit 23
       #);
     GreaterEqual: Comparison
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(GreaterEqual)[] -> V.visit_GreaterEqual #);
       exit 24
       #);
     Term: Comparison
       (# 
       #);
     Addition: Term
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Addition)[] -> V.visit_Addition #);
       exit 26
       #);
     Subtraction: Term
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Subtraction)[] -> V.visit_Subtraction #);
       exit 27
       #);
     Factor: Term
       (# 
       #);
     Multiplication: Factor
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Multiplication)[] -> V.visit_Multiplication #);
       exit 29
       #);
     Division: Factor
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Division)[] -> V.visit_Division #);
       exit 30
       #);
     Unary: Factor
       (# 
       #);
     Negation: Unary
       (# getEvaluation: getson1(# #);
          putEvaluation: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Negation)[] -> V.visit_Negation #);
       exit 32
       #);
     BoolNegation: Unary
       (# getEvaluation: getson1(# #);
          putEvaluation: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(BoolNegation)[] -> V.visit_BoolNegation #);
       exit 33
       #);
     Primary: Unary
       (# 
       #);
     Grouping: Primary
       (# getEvaluation: getson1(# #);
          putEvaluation: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Grouping)[] -> V.visit_Grouping #);
       exit 35
       #);
     BoolExp: Primary
       (# 
       #);
     TrueExp: BoolExp
       (#           astVisitor:: treeLevelVisitor;
          accept::< (# do this(TrueExp)[] -> V.visit_TrueExp #);
exit 37 #);
     FalseExp: BoolExp
       (#           astVisitor:: treeLevelVisitor;
          accept::< (# do this(FalseExp)[] -> V.visit_FalseExp #);
exit 38 #);
     NilExp: Primary
       (#           astVisitor:: treeLevelVisitor;
          accept::< (# do this(NilExp)[] -> V.visit_NilExp #);
exit 39 #);
     Variable: Primary
       (# getNameAppl: getson1(# #);
          putNameAppl: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Variable)[] -> V.visit_Variable #);
       exit 40
       #);
     Number: Primary
       (# getConst: getson1(# #);
          putConst: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Number)[] -> V.visit_Number #);
       exit 41
       #);
     Text: Primary
       (# getString: getson1(# #);
          putString: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Text)[] -> V.visit_Text #);
       exit 42
       #);

     grammarIdentification::<
       (# do 'lox' -> theGrammarName #);
     version::<
       (# do 2 -> value #);
     suffix::<
       (# do '.lox' -> theSuffix #);
     maxproductions::<
       (# do 42 -> value #);

     init::<
       (# <<SLOT InitBody:dopart>> #);

     treeLevelVisitor:: 
       (# 
          visit_Program:<
            (# N: ^lox.Program
            enter N[]
            do INNER
            #);
          visit_VarDecl:<
            (# N: ^lox.VarDecl
            enter N[]
            do INNER
            #);
          visit_Initializer:<
            (# N: ^lox.Initializer
            enter N[]
            do INNER
            #);
          visit_ExprStmt:<
            (# N: ^lox.ExprStmt
            enter N[]
            do INNER
            #);
          visit_PrintStmt:<
            (# N: ^lox.PrintStmt
            enter N[]
            do INNER
            #);
          visit_Block:<
            (# N: ^lox.Block
            enter N[]
            do INNER
            #);
          visit_Assignment:<
            (# N: ^lox.Assignment
            enter N[]
            do INNER
            #);
          visit_Name:<
            (# N: ^lox.Name
            enter N[]
            do INNER
            #);
          visit_LogicOr:<
            (# N: ^lox.LogicOr
            enter N[]
            do INNER
            #);
          visit_LogicAnd:<
            (# N: ^lox.LogicAnd
            enter N[]
            do INNER
            #);
          visit_Equals:<
            (# N: ^lox.Equals
            enter N[]
            do INNER
            #);
          visit_NotEquals:<
            (# N: ^lox.NotEquals
            enter N[]
            do INNER
            #);
          visit_Less:<
            (# N: ^lox.Less
            enter N[]
            do INNER
            #);
          visit_LessEqual:<
            (# N: ^lox.LessEqual
            enter N[]
            do INNER
            #);
          visit_Greater:<
            (# N: ^lox.Greater
            enter N[]
            do INNER
            #);
          visit_GreaterEqual:<
            (# N: ^lox.GreaterEqual
            enter N[]
            do INNER
            #);
          visit_Addition:<
            (# N: ^lox.Addition
            enter N[]
            do INNER
            #);
          visit_Subtraction:<
            (# N: ^lox.Subtraction
            enter N[]
            do INNER
            #);
          visit_Multiplication:<
            (# N: ^lox.Multiplication
            enter N[]
            do INNER
            #);
          visit_Division:<
            (# N: ^lox.Division
            enter N[]
            do INNER
            #);
          visit_Negation:<
            (# N: ^lox.Negation
            enter N[]
            do INNER
            #);
          visit_BoolNegation:<
            (# N: ^lox.BoolNegation
            enter N[]
            do INNER
            #);
          visit_Grouping:<
            (# N: ^lox.Grouping
            enter N[]
            do INNER
            #);
          visit_TrueExp:<
            (# N: ^lox.TrueExp
            enter N[]
            do INNER
            #);
          visit_FalseExp:<
            (# N: ^lox.FalseExp
            enter N[]
            do INNER
            #);
          visit_NilExp:<
            (# N: ^lox.NilExp
            enter N[]
            do INNER
            #);
          visit_Variable:<
            (# N: ^lox.Variable
            enter N[]
            do INNER
            #);
          visit_Number:<
            (# N: ^lox.Number
            enter N[]
            do INNER
            #);
          visit_Text:<
            (# N: ^lox.Text
            enter N[]
            do INNER
            #);
       #);
  #);
 --InitBody:dopart--
do
   1 -> kindArray[1]; 0 -> roomArray[1]; 1 -> sonArray[1]; 
   Program## -> genRefArray[1]##;
   1 -> kindArray[2]; 0 -> roomArray[2]; 0 -> sonArray[2]; 
   Statements## -> genRefArray[2]##;
   2 -> kindArray[3]; 2 -> roomArray[3]; 0 -> sonArray[3]; 
   unExpanded## -> genRefArray[3]##;
   1 -> kindArray[4]; 0 -> roomArray[4]; 2 -> sonArray[4]; 
   VarDecl## -> genRefArray[4]##;
   3 -> kindArray[5]; 2 -> roomArray[5]; 0 -> sonArray[5]; 
   Optional## -> genRefArray[5]##;
   1 -> kindArray[6]; 0 -> roomArray[6]; 1 -> sonArray[6]; 
   Initializer## -> genRefArray[6]##;
   1 -> kindArray[7]; 0 -> roomArray[7]; 1 -> sonArray[7]; 
   ExprStmt## -> genRefArray[7]##;
   1 -> kindArray[8]; 0 -> roomArray[8]; 1 -> sonArray[8]; 
   PrintStmt## -> genRefArray[8]##;
   1 -> kindArray[9]; 0 -> roomArray[9]; 1 -> sonArray[9]; 
   Block## -> genRefArray[9]##;
   2 -> kindArray[10]; 2 -> roomArray[10]; 0 -> sonArray[10]; 
   unExpanded## -> genRefArray[10]##;
   1 -> kindArray[11]; 0 -> roomArray[11]; 2 -> sonArray[11]; 
   Assignment## -> genRefArray[11]##;
   1 -> kindArray[12]; 0 -> roomArray[12]; 1 -> sonArray[12]; 
   Name## -> genRefArray[12]##;
   2 -> kindArray[13]; 2 -> roomArray[13]; 0 -> sonArray[13]; 
   unExpanded## -> genRefArray[13]##;
   1 -> kindArray[14]; 0 -> roomArray[14]; 2 -> sonArray[14]; 
   LogicOr## -> genRefArray[14]##;
   2 -> kindArray[15]; 2 -> roomArray[15]; 0 -> sonArray[15]; 
   unExpanded## -> genRefArray[15]##;
   1 -> kindArray[16]; 0 -> roomArray[16]; 2 -> sonArray[16]; 
   LogicAnd## -> genRefArray[16]##;
   2 -> kindArray[17]; 2 -> roomArray[17]; 0 -> sonArray[17]; 
   unExpanded## -> genRefArray[17]##;
   1 -> kindArray[18]; 0 -> roomArray[18]; 2 -> sonArray[18]; 
   Equals## -> genRefArray[18]##;
   1 -> kindArray[19]; 0 -> roomArray[19]; 2 -> sonArray[19]; 
   NotEquals## -> genRefArray[19]##;
   2 -> kindArray[20]; 2 -> roomArray[20]; 0 -> sonArray[20]; 
   unExpanded## -> genRefArray[20]##;
   1 -> kindArray[21]; 0 -> roomArray[21]; 2 -> sonArray[21]; 
   Less## -> genRefArray[21]##;
