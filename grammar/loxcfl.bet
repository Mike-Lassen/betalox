ORIGIN '~beta/newmps/astlevel'
--astInterfaceLib: attributes--

lox: TreeLevel
  (# <<SLOT loxAttributes:attributes>>;
     Program: cons
       (# getDeclarations: getson1(# #);
          putDeclarations: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Program)[] -> V.visit_Program #);
       exit 1
       #);
     Declarations: list
       (# soncat::< Declaration;
       exit 2
       #);
     Declaration: cons
       (# 
       #);
     Statement: Declaration
       (# 
       #);
     VarDecl: Declaration
       (# getName: getson1(# #);
          putName: putson1(# #);
          getInitializerOpt: getson2(# #);
          putInitializerOpt: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(VarDecl)[] -> V.visit_VarDecl #);
       exit 5
       #);
     FunDecl: Declaration
       (# getFunction: getson1(# #);
          putFunction: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(FunDecl)[] -> V.visit_FunDecl #);
       exit 6
       #);
     ClassDecl: Declaration
       (# getName: getson1(# #);
          putName: putson1(# #);
          getFunctions: getson2(# #);
          putFunctions: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(ClassDecl)[] -> V.visit_ClassDecl #);
       exit 7
       #);
     Functions: list
       (# soncat::< Function;
       exit 8
       #);
     Function: cons
       (# getName: getson1(# #);
          putName: putson1(# #);
          getParameters: getson2(# #);
          putParameters: putson2(# #);
          getBlock: getson3(# #);
          putBlock: putson3(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Function)[] -> V.visit_Function #);
       exit 9
       #);
     Parameters: list
       (# soncat::< Name;
       exit 10
       #);
     Initializer: cons
       (# getExpression: getson1(# #);
          putExpression: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Initializer)[] -> V.visit_Initializer #);
       exit 12
       #);
     ExprStmt: Statement
       (# getExpression: getson1(# #);
          putExpression: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(ExprStmt)[] -> V.visit_ExprStmt #);
       exit 13
       #);
     PrintStmt: Statement
       (# getExpression: getson1(# #);
          putExpression: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(PrintStmt)[] -> V.visit_PrintStmt #);
       exit 14
       #);
     NewlineStmt: Statement
       (#           astVisitor:: treeLevelVisitor;
          accept::< (# do this(NewlineStmt)[] -> V.visit_NewlineStmt #);
exit 15 #);
     Block: Statement
       (# getDeclarations: getson1(# #);
          putDeclarations: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Block)[] -> V.visit_Block #);
       exit 16
       #);
     IfStmt: Statement
       (# getCondition: getson1(# #);
          putCondition: putson1(# #);
          getStatement: getson2(# #);
          putStatement: putson2(# #);
          getElsePartOpt: getson3(# #);
          putElsePartOpt: putson3(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(IfStmt)[] -> V.visit_IfStmt #);
       exit 17
       #);
     WhileStmt: Statement
       (# getCondition: getson1(# #);
          putCondition: putson1(# #);
          getStatement: getson2(# #);
          putStatement: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(WhileStmt)[] -> V.visit_WhileStmt #);
       exit 18
       #);
     ReturnStmt: Statement
       (# getExpressionOpt: getson1(# #);
          putExpressionOpt: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(ReturnStmt)[] -> V.visit_ReturnStmt #);
       exit 19
       #);
     ElsePart: cons
       (# getStatement: getson1(# #);
          putStatement: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(ElsePart)[] -> V.visit_ElsePart #);
       exit 21
       #);
     Expression: cons
       (# 
       <<SLOT ExpressionAttributes:attributes>>; #);
     Assignment: Expression
       (# getTarget: getson1(# #);
          putTarget: putson1(# #);
          getExpression: getson2(# #);
          putExpression: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Assignment)[] -> V.visit_Assignment #);
       exit 24
       #);
     Target: cons
       (# 
       #);
     Remote: Target
       (# getExpression: getson1(# #);
          putExpression: putson1(# #);
          getProperty: getson2(# #);
          putProperty: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Remote)[] -> V.visit_Remote #);
       exit 26
       #);
     Simple: Target
       (# getVariable: getson1(# #);
          putVariable: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Simple)[] -> V.visit_Simple #);
       exit 27
       #);
     Name: cons
       (# getNameDecl: getson1(# #);
          putNameDecl: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Name)[] -> V.visit_Name #);
          <<SLOT NameAttributes:attributes>>; 
       exit 28
       #);
     Evaluation: Expression
       (# 
       #);
     LogicOr: Evaluation
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(LogicOr)[] -> V.visit_LogicOr #);
       exit 30
       #);
     Equivalence: Evaluation
       (# 
       #);
     LogicAnd: Equivalence
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(LogicAnd)[] -> V.visit_LogicAnd #);
       exit 32
       #);
     Equality: Equivalence
       (# 
       #);
     Equals: Equality
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Equals)[] -> V.visit_Equals #);
       exit 34
       #);
     NotEquals: Equality
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(NotEquals)[] -> V.visit_NotEquals #);
       exit 35
       #);
     Comparison: Equality
       (# 
       #);
     Less: Comparison
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Less)[] -> V.visit_Less #);
       exit 37
       #);
     LessEqual: Comparison
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(LessEqual)[] -> V.visit_LessEqual #);
       exit 38
       #);
     Greater: Comparison
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Greater)[] -> V.visit_Greater #);
       exit 39
       #);
     GreaterEqual: Comparison
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(GreaterEqual)[] -> V.visit_GreaterEqual #);
       exit 40
       #);
     Term: Comparison
       (# 
       #);
     Addition: Term
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Addition)[] -> V.visit_Addition #);
       exit 42
       #);
     Subtraction: Term
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Subtraction)[] -> V.visit_Subtraction #);
       exit 43
       #);
     Factor: Term
       (# 
       #);
     Multiplication: Factor
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Multiplication)[] -> V.visit_Multiplication #);
       exit 45
       #);
     Division: Factor
       (# getLeftSide: getson1(# #);
          putLeftSide: putson1(# #);
          getRightSide: getson2(# #);
          putRightSide: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Division)[] -> V.visit_Division #);
       exit 46
       #);
     Unary: Factor
       (# 
       #);
     Negation: Unary
       (# getEvaluation: getson1(# #);
          putEvaluation: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Negation)[] -> V.visit_Negation #);
       exit 48
       #);
     BoolNegation: Unary
       (# getEvaluation: getson1(# #);
          putEvaluation: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(BoolNegation)[] -> V.visit_BoolNegation #);
       exit 49
       #);
     Call: Unary
       (# getExpression: getson1(# #);
          putExpression: putson1(# #);
          getAccess: getson2(# #);
          putAccess: putson2(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Call)[] -> V.visit_Call #);
       exit 50
       #);
     Access: cons
       (# 
       #);
     Method: Access
       (# getArguments: getson1(# #);
          putArguments: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Method)[] -> V.visit_Method #);
       exit 52
       #);
     Property: Access
       (# getNameAppl: getson1(# #);
          putNameAppl: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Property)[] -> V.visit_Property #);
          <<SLOT PropertyAttributes:attributes>>; 
       exit 53
       #);
     Arguments: list
       (# soncat::< Expression;
       exit 54
       #);
     Primary: Unary
       (# 
       #);
     Grouping: Primary
       (# getEvaluation: getson1(# #);
          putEvaluation: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Grouping)[] -> V.visit_Grouping #);
       exit 56
       #);
     BoolExp: Primary
       (# 
       #);
     TrueExp: BoolExp
       (#           astVisitor:: treeLevelVisitor;
          accept::< (# do this(TrueExp)[] -> V.visit_TrueExp #);
exit 58 #);
     FalseExp: BoolExp
       (#           astVisitor:: treeLevelVisitor;
          accept::< (# do this(FalseExp)[] -> V.visit_FalseExp #);
exit 59 #);
     NilExp: Primary
       (#           astVisitor:: treeLevelVisitor;
          accept::< (# do this(NilExp)[] -> V.visit_NilExp #);
exit 60 #);
     ThisExp: Primary
       (#           astVisitor:: treeLevelVisitor;
          accept::< (# do this(ThisExp)[] -> V.visit_ThisExp #);
          distance: @integer;
          pack::<
            (#
            do distance -> putValue;
               INNER;
            #);
          unPack::<
            (#
            do getValue -> distance;
               INNER;
            #);
exit 61 #);
     Variable: Primary
       (# getNameAppl: getson1(# #);
          putNameAppl: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Variable)[] -> V.visit_Variable #);
          distance: @integer;
          pack::<
            (#
            do distance -> putValue;
               INNER;
            #);
          unPack::<
            (#
            do getValue -> distance;
               INNER;
            #);
          <<SLOT VariableAttributes:attributes>>; 
       exit 62
       #);
     Number: Primary
       (# getConst: getson1(# #);
          putConst: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Number)[] -> V.visit_Number #);
       exit 63
       #);
     Text: Primary
       (# getString: getson1(# #);
          putString: putson1(# #);
          astVisitor:: treeLevelVisitor;
          accept::< (# do this(Text)[] -> V.visit_Text #);
       exit 64
       #);

     grammarIdentification::<
       (# do 'lox' -> theGrammarName #);
     version::<
       (# do 4 -> value #);
     suffix::<
       (# do '.lox' -> theSuffix #);
     maxproductions::<
       (# do 64 -> value #);

     init::<
       (# <<SLOT InitBody:dopart>> #);

     treeLevelVisitor:: 
       (# 
          visit_Program:<
            (# N: ^lox.Program
            enter N[]
            do INNER
            #);
          visit_VarDecl:<
            (# N: ^lox.VarDecl
            enter N[]
            do INNER
            #);
          visit_FunDecl:<
            (# N: ^lox.FunDecl
            enter N[]
            do INNER
            #);
          visit_ClassDecl:<
            (# N: ^lox.ClassDecl
            enter N[]
            do INNER
            #);
          visit_Function:<
            (# N: ^lox.Function
            enter N[]
            do INNER
            #);
          visit_Initializer:<
            (# N: ^lox.Initializer
            enter N[]
            do INNER
            #);
          visit_ExprStmt:<
            (# N: ^lox.ExprStmt
            enter N[]
            do INNER
            #);
          visit_PrintStmt:<
            (# N: ^lox.PrintStmt
            enter N[]
            do INNER
            #);
          visit_NewlineStmt:<
            (# N: ^lox.NewlineStmt
            enter N[]
            do INNER
            #);
          visit_Block:<
            (# N: ^lox.Block
            enter N[]
            do INNER
            #);
          visit_IfStmt:<
            (# N: ^lox.IfStmt
            enter N[]
            do INNER
            #);
          visit_WhileStmt:<
            (# N: ^lox.WhileStmt
            enter N[]
            do INNER
            #);
          visit_ReturnStmt:<
            (# N: ^lox.ReturnStmt
            enter N[]
            do INNER
            #);
          visit_ElsePart:<
            (# N: ^lox.ElsePart
            enter N[]
            do INNER
            #);
          visit_Assignment:<
            (# N: ^lox.Assignment
            enter N[]
            do INNER
            #);
          visit_Remote:<
            (# N: ^lox.Remote
            enter N[]
            do INNER
            #);
          visit_Simple:<
            (# N: ^lox.Simple
            enter N[]
            do INNER
            #);
          visit_Name:<
            (# N: ^lox.Name
            enter N[]
            do INNER
            #);
          visit_LogicOr:<
            (# N: ^lox.LogicOr
            enter N[]
            do INNER
            #);
          visit_LogicAnd:<
            (# N: ^lox.LogicAnd
            enter N[]
            do INNER
            #);
          visit_Equals:<
            (# N: ^lox.Equals
            enter N[]
            do INNER
            #);
          visit_NotEquals:<
            (# N: ^lox.NotEquals
            enter N[]
            do INNER
            #);
          visit_Less:<
            (# N: ^lox.Less
            enter N[]
            do INNER
            #);
          visit_LessEqual:<
            (# N: ^lox.LessEqual
            enter N[]
            do INNER
            #);
          visit_Greater:<
            (# N: ^lox.Greater
            enter N[]
            do INNER
            #);
          visit_GreaterEqual:<
            (# N: ^lox.GreaterEqual
            enter N[]
            do INNER
            #);
          visit_Addition:<
            (# N: ^lox.Addition
            enter N[]
            do INNER
            #);
          visit_Subtraction:<
            (# N: ^lox.Subtraction
            enter N[]
            do INNER
            #);
          visit_Multiplication:<
            (# N: ^lox.Multiplication
            enter N[]
            do INNER
            #);
          visit_Division:<
            (# N: ^lox.Division
            enter N[]
            do INNER
            #);
          visit_Negation:<
            (# N: ^lox.Negation
            enter N[]
            do INNER
            #);
          visit_BoolNegation:<
            (# N: ^lox.BoolNegation
            enter N[]
            do INNER
            #);
          visit_Call:<
            (# N: ^lox.Call
            enter N[]
            do INNER
            #);
          visit_Method:<
            (# N: ^lox.Method
            enter N[]
            do INNER
            #);
          visit_Property:<
            (# N: ^lox.Property
            enter N[]
            do INNER
            #);
          visit_Grouping:<
            (# N: ^lox.Grouping
            enter N[]
            do INNER
            #);
          visit_TrueExp:<
            (# N: ^lox.TrueExp
            enter N[]
            do INNER
            #);
          visit_FalseExp:<
            (# N: ^lox.FalseExp
            enter N[]
            do INNER
            #);
          visit_NilExp:<
            (# N: ^lox.NilExp
            enter N[]
            do INNER
            #);
          visit_ThisExp:<
            (# N: ^lox.ThisExp
            enter N[]
            do INNER
            #);
          visit_Variable:<
            (# N: ^lox.Variable
            enter N[]
            do INNER
            #);
          visit_Number:<
            (# N: ^lox.Number
            enter N[]
            do INNER
            #);
          visit_Text:<
            (# N: ^lox.Text
            enter N[]
            do INNER
            #);
       #);
  #);
 --InitBody:dopart--
do
   1 -> kindArray[1]; 0 -> roomArray[1]; 1 -> sonArray[1]; 
   Program## -> genRefArray[1]##;
   1 -> kindArray[2]; 0 -> roomArray[2]; 0 -> sonArray[2]; 
   Declarations## -> genRefArray[2]##;
   2 -> kindArray[3]; 2 -> roomArray[3]; 0 -> sonArray[3]; 
   unExpanded## -> genRefArray[3]##;
