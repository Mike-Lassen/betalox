   Negation## -> genRefArray[32]##;
   1 -> kindArray[33]; 0 -> roomArray[33]; 1 -> sonArray[33]; 
   BoolNegation## -> genRefArray[33]##;
   2 -> kindArray[34]; 2 -> roomArray[34]; 0 -> sonArray[34]; 
   unExpanded## -> genRefArray[34]##;
   1 -> kindArray[35]; 0 -> roomArray[35]; 1 -> sonArray[35]; 
   Grouping## -> genRefArray[35]##;
