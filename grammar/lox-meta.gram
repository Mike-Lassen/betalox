--- lox : aGrammar : metagrammar---
Grammar lox:

Option
  version=4
  comBegin='/*'
  comEnd='*/'
  stringChar='\"'
  suffix='.lox'

Rule

<Program> ::= <Statements> ;

<Statements> ::* <Statement> ;

<Statement> ::| <Declaration> 
              | <ExprStmt> 
              | <PrintStmt> 
              | <NewlineStmt> 
              | <Block> 
              | <IfStmt> 
              | <WhileStmt> 
              | <ReturnStmt>
              ;

<Declaration> ::| <VarDecl> | <FunDecl> | <ClassDecl>;

<VarDecl> ::= 'var' <Name> <InitializerOpt> ';' ;

<FunDecl> ::= 'fun' <Function> ;

<ClassDecl> ::= 'class' <Name> '{' <Functions> '}' ;

<Functions> ::* <Function> ;

<Function> ::= <Name> '(' <Parameters> ')' <Block> ;

<Parameters> ::* <Name> ',' ;

<InitializerOpt> ::? <Initializer> ;

<Initializer> ::= '=' <Expression> ;

<ExprStmt> ::= <Expression> ';' ;

<PrintStmt> ::= 'print' <Expression> ';' ;

<NewlineStmt> ::= 'newline' ';';

<Block> ::= '{' <Statements> '}' ;

<IfStmt> ::= 'if' '(' <Condition:Expression> ')' <Statement> <ElsePartOpt>;

<WhileStmt> ::= 'while' '(' <Condition:Expression> ')' <Statement> ;

<ReturnStmt> ::= 'return' <ExpressionOpt> ';' ;

<ElsePartOpt> ::? <ElsePart> ;

<ElsePart> ::= 'else' <Statement> ;

<ExpressionOpt> ::? <Expression> ;

<Expression> ::| <Assignment> | <Evaluation> ;

<Assignment> ::= <Target> '=' <Expression> ;

<Target> ::| <Simple> | <Remote> ;

<Remote> ::= <Expression:Unary> <Property> ;

<Simple> ::= <Variable> ;

<Name> ::= <NameDecl> ;

<Evaluation> ::| <LogicOr> | <Equivalence> ;
<LogicOr> ::= <LeftSide:Evaluation> 'or' <RightSide:Equivalence> ;

<Equivalence> ::| <LogicAnd> | <Equality> ;
<LogicAnd> ::= <LeftSide:Equivalence> 'and' <RightSide:Equality> ;

<Equality> ::| <Equals> | <NotEquals> | <Comparison> ;
<Equals> ::= <LeftSide:Equality> '==' <RightSide:Comparison> ;
<NotEquals> ::= <LeftSide:Equality> '!=' <RightSide:Comparison> ;

<Comparison>::| <Less> | <LessEqual> | <Greater> | <GreaterEqual> | <Term> ;
<Less> ::= <LeftSide:Comparison> '<' <RightSide:Term> ;
<LessEqual> ::= <LeftSide:Comparison> '<=' <RightSide:Term> ;
<Greater> ::= <LeftSide:Comparison> '>' <RightSide:Term> ;
<GreaterEqual> ::= <LeftSide:Comparison> '>=' <RightSide:Term> ;

<Term> ::| <Addition> | <Subtraction> | <Factor> ;
<Addition> ::= <LeftSide:Term> '+' <RightSide:Factor> ;
<Subtraction> ::= <LeftSide:Term> '-' <RightSide:Factor> ;

<Factor> ::| <Multiplication> | <Division> | <Unary> ;
<Multiplication> ::= <LeftSide:Factor> '*' <RightSide:Unary> ;
<Division> ::= <LeftSide:Factor> '/' <RightSide:Unary> ;

<Unary> ::| <Negation> | <BoolNegation> | <Call> | <Primary>;
<Negation> ::= '-' <Evaluation:Unary> ;
<BoolNegation> ::= '!' <Evaluation:Unary> ;

<Call> ::= <Expression:Unary> <Access> ;

<Access> ::| <Method> | <Property> ;

<Method> ::= '(' <Arguments> ')' ;

<Property> ::= '.' <NameAppl> ;

<Arguments> ::* <Expression> ',' ;

<Primary>       ::| <Variable>
                  | <ThisExp>
                  | <Number>
                  | <Text>
                  | <BoolExp>
                  | <NilExp>
                  | <Grouping> ;

<Grouping> ::= '(' <Evaluation> ')' ;

<BoolExp>  ::| <TrueExp> | <FalseExp> ;
<TrueExp>  ::= 'true' ;
<FalseExp> ::= 'false' ;
<NilExp>   ::= 'nil' ;
<ThisExp>  ::= 'this' ;

<Variable>      ::= <NameAppl> ;
<Number>        ::= <Const> ;
<Text>          ::= <String> 

Attribute

<Expression>: 0
<Variable>: 0
<Name>: 0
<Property>: 0


<Variable>:
(# distance: integer
#)
<ThisExp>:
(# distance: integer
#)
