ORIGIN '~beta/newmps/astlevel';
INCLUDE 'loxsematt';
INCLUDE 'grammar/loxcfl';
INCLUDE 'grammar/loxgram';
INCLUDE '~beta/basiclib/numberio';
INCLUDE '~beta/basiclib/math';
INCLUDE '~beta/sysutils/time';
INCLUDE '~beta/containers/dictionary';
INCLUDE '~beta/containers/seqContainers';
INCLUDE '~beta/sysutils/objinterface';

-- lib: attributes --
Interpreter: AstInterface
  (# loxcfl: @lox;
     gram: @grammar;
     trace: @boolean;

     dumpAst:
       (# node: ^AST;
       enter node[]
       do (1, screen[], loxcfl[])->node.dump;
       #);

     ArgumentList: Deque
       (# Element:: LoxValue;
       #);
     LoxValue:
       (# dump:<
            (# output: ^Stream;
            enter output[]
            do INNER
            #);
          isNil:< booleanValue;
          isNumber:< booleanValue;
          asNumber:<
            (# value: @real
            do INNER
            exit value
            #);
          isBoolean:< booleanValue;
          asBoolean:<
            (# value: @boolean;
            do INNER
            exit value
            #);
          isString:< booleanValue;
          asString:<
            (# value: ^Text;
            do INNER
            exit value[]
            #);
          isCallable:< booleanValue;
          asCallable:<
            (# callable: ^LoxCallable;
            do INNER;
            exit callable[]
            #);
          isClass:< booleanValue;
          asClass:<
            (# value: ^LoxClass;
            do INNER
            exit value[]
            #);
          isInstance:< booleanValue;
          asInstance:<
            (# instance: ^LoxInstance;
            do INNER
            exit instance[]
            #);  
          isTruthy:< booleanValue;
       #);
     LoxNumber: LoxValue
       (# value: @real;
          dump:: 
            (# 
            do value->output.putReal;
            #);
          isNumber:: trueValue;
          isInteger:
            (# result: @boolean;
            do (if (value -> floor) = value then
                   true -> result;
               if);
            exit result
            #);
          asNumber:: 
            (# 
            do THIS(LoxNumber).value->value
            #);
          asString:: 
            (# 
            do &Text[]->value[];
               (if isInteger then
                   THIS(LoxNumber).value->value.putInt;
               else
                   THIS(LoxNumber).value->value.putReal;
               if)
               
            #);
          isTruthy:: trueValue;
       enter value
       exit value
       #);
     LoxBoolean: LoxValue
       (# value: @boolean;
          dump:: 
            (# 
            do (if value then
                   'true'->screen.putText;
                else
                   'false'->screen.putText;
               if)
            #);
          isBoolean:: trueValue;
          asBoolean:: 
            (# 
            do THIS(LoxBoolean).value->value;
            #);
          asString:: 
            (# 
            do (if THIS(LoxBoolean).value then
                   'true'->value[];
                else
                   'false'->value[];
               if);
            #);
          isTruthy:: 
            (# 
            do THIS(LoxBoolean).value->value;
            #);
       #);
     LoxString: LoxValue
       (# value: ^Text;
          isString:: trueValue;
          asString:: 
            (# 
            do THIS(LoxString).value[]->value[];
            #);
          dump:: 
            (# 
            do value[]->output.putText;
            #);
          isTruthy:: trueValue;
       #);
     LoxNil: @LoxValue
       (# isNil:: trueValue;
          isTruthy:: falseValue;
          asString:: 
            (# 
            do 'nil'->value[];
            #);
          dump:: 
            (# 
            do 'nil'->output.putText;
            #);
       #);
     LoxCallable: LoxValue
       (# isNil:: falseValue;
          isTruthy:: trueValue;
          isCallable:: trueValue;
          asCallable:: 
            (# 
            do THIS(LoxCallable)[]->callable[]
            #);
          arity:< integerValue;
          call:<
            (# arguments: ^ArgumentList;
               result: ^LoxValue;
            enter arguments[]
            do INNER
            exit result[]
            #);
       #);
     LoxFunction: LoxCallable
       (# name: ^Text;
          closure: ^Environment;
          parameters: ^loxcfl.Parameters;
          block: ^loxcfl.Block;
          bind:
            (# instance: ^LoxInstance;
               function: ^LoxFunction;
               env: ^Environment;
            enter instance[]
            do &Environment[] -> env[];
               closure[] -> env.init;
               ('this', instance[]) -> env.define;
               &LoxFunction[] -> function[];
               env[] -> function.closure[];
               'bound ' -> function.name[];
               name[] -> function.name.puttext;
               parameters[] -> function.parameters[];
               block[] -> function.block[];
            exit function[]   
            #);
          arity:: 
            (# 
            do parameters.noOfSons->value
            #);
          call:: 
            (# env: ^Environment;
            do &Environment[]->env[];
               closure[]->env.init;
               parameters.newScan
                 (# val: ^LoxValue;
                 do arguments.removeFront->val[];
                    (current.getText, val[])->env.define;
                 #);
               executing:
                 (# 
                 do (env[], block[])
                      ->InterpretStatement
                        (# onReturn:: 
                             (# 
                             do value[]->result[];
                                leave executing;
                             #);
                        #);
                    LoxNil[]->result[];
                 #);
            #);
          asString:: 
            (# 
            do '<fun '->value[];
               name[]->value.putText;
               '>'->value.putText;
            #);
       #);
     LoxClass: LoxCallable
       (# name: ^Text;
          methods: ^FunctionDictionary;
          init:
            (#
            enter (name[], methods[])
            #);
          asString::
            (#
            do name[] -> value[];
            #);
          isClass:: trueValue;
          asClass::
            (# do THIS(LoxClass)[] -> value[] #);
          call::
            (# instance: ^LoxInstance;
            do &LoxInstance[] -> instance[];
               THIS(LoxClass)[] -> instance.init;
               instance[] -> result[];
            #);  
       #);
     LoxInstance: LoxValue
       (# isInstance:: trueValue;
          asInstance::
            (#
            do THIS(LoxInstance)[] -> instance[];
            #);
          class: ^LoxClass;
          fields: @ValueDictionary;
          init:
            (#
            enter class[]
            do fields.init;
            #);
          asString::
            (#
            do &Text[] -> value[];
               class.name[] -> value.putText;
               ' instance' -> value.putText;
            #);
          assign:
            (# name: ^Text;
               value: ^LoxValue;
            enter (name[], value[])   
            do (name[], value[]) -> fields.associate;
            #);
          get:
            (# name: ^Text;
               value: ^LoxValue;
               function: ^LoxFunction;
            enter name[]   
            do name[] -> fields.lookup -> value[];
               (if value[] = NONE then
                   name[] -> class.methods.lookup -> function[];
                   (if function[] <> NONE then
                       THIS(LoxInstance)[] -> function.bind -> value[];
                   if);
               if);
            exit value[]
            #);
       #);
     NativeFunction: LoxCallable
       (# asString:: 
            (# 
            do '<native '->value[];
               THIS(NativeFunction)[]->getPatternName->value.putText;
               '>'->value.putText;
            #);
       #);
     Clock: NativeFunction
       (# arity:: 
            (# 
            do 0->value
            #);
          call:: 
            (# number: @LoxNumber;
            do cpuTime->number.value;
               number[]->result[];
            #);
       #);
     TextKeyDictionary: dictionary
       (# key:: Text;
          hashFunction:: 
            (# 
            do k.scanAll
                 (# 
                 do 131*value+ch->value;
                 #);
               (if value < 0 then
                   - value->value;
               if);
            #);
          keyEqual:: 
            (# 
            do left[]->right.equal->value
            #);
       #);
     ValueDictionary: TextKeyDictionary
       (# element:: LoxValue;
       #);
     FunctionDictionary: TextKeyDictionary
       (# element:: LoxFunction;
       #);
     Environment:
       (# values: @ValueDictionary;
          enclosing: ^Environment;
          init:
            (# 
            enter enclosing[]
            do values.init;
            #);
          isDefined:
            (# name: ^Text;
               result: @boolean;
            enter name[]
            do (name[]->values.lookup) <> none->result;
            exit result
            #);
          define:
            (# name: ^Text;
               value: ^LoxValue;
               ok: @boolean;
            enter (name[], value[])
            do (if not (name[]->isDefined) then
                   (name[], value[])->values.associate;
                   true->ok;
               if);
            exit ok
            #);
          get:
            (# name: ^Text;
               value: ^LoxValue;
            enter name[]
            do name[]->values.lookup->value[];
            exit value[]
            #);
          getAt:
            (# name: ^Text;
               distance: @integer;
               value: ^LoxValue;
               current: ^Environment;
            enter (name[], distance)
            do THIS(Environment)[] -> current[];
               (for distance repeat
                   current.enclosing[] -> current[];
               for);
               name[] -> current.get -> value[];
            exit value[]
            #);
          assign:
            (# name: ^Text;
               value: ^LoxValue;
               ok: @boolean;
            enter (name[], value[])
            do (if name[]->isDefined then
                   (name[], value[])->values.associate;
                   true->ok;
                else
                   (if enclosing[] <> none then
                       (name[], value[])->enclosing.assign->ok;
                   if);
               if);
            exit ok
            #);
          display:
            (# 
            do values.scanAssociations
                 (# 
                 do k[]->screen.putText;
                    ': '->screen.putText;
                    e.asString->screen.putLine;
                 #);
               (if enclosing[] <> none then
                   '-- ENCLOSING -- '->screen.putLine;
                   enclosing.display;
               if);
            #);
       #);
     globals: ^Environment;
     interpretFile:
       (# name: ^Text;
          group: ^FragmentGroup;
       enter name[]
       do (name[], screen[])->TOP.open->group[];
          (if group[] <> none then
              (if trace then
                  'Executing group '->screen.putLine;
                  '  shortName: ' ->  screen.putText;
                  group.shortName -> screen.putLine;
                  '  textFileName: ' ->  screen.putText;
                  group.textFileName->screen.putLine;
                  '  diskFileName: ' ->  screen.putText;
                  group.diskFileName->screen.putLine;
                  '  fullName: ' ->  screen.putText;
                  group.fullName->screen.putLine;
                   '  name: ' ->  screen.putText;
                  group.name->screen.putLine;
              if);
              group.scan
                (# form: ^FragmentForm;
                do current[]->form[];
                   (if trace then
                       'Executing fragment '->screen.putText;
                       current.name->screen.putLine;
                       (1, screen[], loxcfl[])->form.root.dump;
                       screen.newline;
                       screen.newline;
                   if);
                   interpreting:
                   (globals[], form.root[])->InterpretProgram
                     (# semanticError::
                          (#
                          do screen.newline;
                             '=== Semantic Error ===' -> screen.putLine;
                             node[] -> dumpAst;
                             screen.newline;
                             '*** ' -> screen.putText;
                             message[] -> screen.putLine;
                             '---- char positions: ' -> screen.putText;
                             node.start -> screen.putInt;
                             ', ' -> screen.putText;
                             node.end -> screen.putInt;
                             screen.newline;
                             'Execution stopped because of semantic error' -> screen.putLine;
                             leave interpreting;
                          #);
                        runtimeError::
                          (#
                          do screen.newline;
                             '=== Runtime Error ===' -> screen.putLine;
                             node[] -> dumpAst;
                             screen.newline;
                             '*** ' -> screen.putText;
                             message[] -> screen.putLine;
                             '---- char positions: ' -> screen.putText;
                             node.start -> screen.putInt;
                             ', ' -> screen.putText;
                             node.end -> screen.putInt;
                             screen.newline;
                             'Execution stopped because of runtime error' -> screen.putLine;
                             leave interpreting;
                          #);  
                     #);
                #);
           else
              'Unable to open '->screen.putText;
              name[]->screen.putLine;
          if);
       #);
     Scope:
       (# enclosing: ^Scope;
          declarations: @TextKeyDictionary
            (# element:: NameDeclaration
            #);
          init:
            (# 
            enter enclosing[]
            do declarations.init;
            #);
          declare:
            (# name: ^Text;
               decl: ^NameDeclaration;
            enter (name[], decl[])
            do (name[], decl[])->declarations.associate;
            #);
          lookup:
            (# name: ^Text;
               decl: ^NameDeclaration;
            enter name[]
            do name[] -> declarations.lookup -> decl[];
            exit decl[]
            #);
       #);
     NameDeclaration:
       (# defined: @boolean;
       #);
     Resolver:
       (# error:<
            (# node: ^AST;
               message: ^Text;
            enter (node[], message[])
            do INNER;
               message[]->screen.putLine;
               (failureTrace, message[]) -> stop;
            #);
          declare:
            (# name: ^Text;
               decl: ^NameDeclaration;
            enter name[]
            do (if top[] <> NONE then
                   &NameDeclaration[]->decl[];
                   (name[], decl[])->top.declare;
               if);
            exit decl[]
            #);
          define:
            (# name: ^Text;
            enter name[]
            do (if top[] <> NONE then
                   true -> (name[]->declare).defined;
               if)
            #);  
          resolveLocal:
            (# name: ^Text;
               current: ^Scope;
               distance: @integer;
            enter name[]
            do top[] -> current[];
               0 -> distance;
               loop: (if current[] <> NONE then
                         (if (name[] -> current.lookup) = NONE then
                             distance + 1 -> distance;
                             current.enclosing[] -> current[];
                             restart loop;
                         if)
                     if);
                (if current[] = NONE then
                    -1 -> distance;
                if);
            exit distance
            #);
          top: ^Scope;
          functionTypes: @
            (# main: (# exit 1 #);
               function: (# exit 2 #);
               method: (# exit 3 #);
            #);
          currentFunction: @integer;

          beginScope:
            (# new: ^Scope;
            do &Scope[]->new[];
               top[]->new.init;
               new[]->top[];
            #);
          endScope:
            (# 
            do top.enclosing[]->top[];
            #);
          resolveProgram:
            (# program: ^loxcfl.Program;
            enter program[]
            do program.getDeclarations->resolveStatements;
            #);
          resolveStatements:
            (# declarations: ^loxcfl.Declarations;
            enter declarations[]
            do declarations.newScan
                 (# 
                 do current[]->resolveDeclaration;
                 #);
            #);
          resolveDeclaration:
            (# declaration: ^loxcfl.Declaration;
               visitor: @loxcfl.treeLevelVisitor
                 (# visit_Block:: 
                      (# 
                      do beginScope;
                         N.getDeclarations->resolveStatements;
                         endScope;
                      #);
                    visit_VarDecl:: 
                      (# decl: ^NameDeclaration;
                         initializer: ^AST;
                         resolver: @loxcfl.treeLevelVisitor
                           (# visit_Initializer::
                                (#
                                do N.getExpression -> resolveExpression;
                                #);
                           #);
                         name: ^loxcfl.Name;  
                      do N.getName -> name[];
                         name.getText->declare->decl[];
                         N.getInitializerOpt->initializer[];
                         resolver[] -> initializer.accept;
                         (if decl[] <> NONE then
                              true->decl.defined;
                         if);
                      #);
                    visit_ExprStmt:: 
                      (# 
                      do N.getExpression->resolveExpression;
                      #);
                    visit_PrintStmt:: 
                      (# 
                      do N.getExpression->resolveExpression;
                      #);
                    visit_FunDecl:: 
                      (# 
                      do (N.getFunction, functionTypes.function)->resolveFunction;
                      #);
                    visit_ClassDecl::
                      (# functions: ^loxcfl.Functions;
                         name: ^loxcfl.Name;
                      do N.getName->name[];
                         name.getText -> define;
                         beginScope;
                         'this' -> define;
                         N.getFunctions -> functions[];
                         functions.newScan
                           (#
                           do (current[], functionTypes.method) -> resolveFunction;
                           #);
                         endScope;
                      #);
                    visit_IfStmt:: 
                      (# resolver: @loxcfl.treeLevelVisitor
                           (# visit_ElsePart:: 
                                (# 
                                do N.getStatement->resolveDeclaration;
                                #);
                           #);
                      do N.getCondition->resolveExpression;
                         N.getStatement->resolveDeclaration;
                         resolver[]->(N.getElsePartOpt).accept;
                      #);
                    visit_WhileStmt:: 
                      (# 
                      do N.getCondition->resolveExpression;
                         N.getStatement->resolveDeclaration;
                      #);
                    visit_ReturnStmt:: 
                      (# expression: ^AST;
                      do (if currentFunction = functionTypes.main then
                           (N[], 'Cant return from top-level code.') -> error;
                         if);
                         N.getExpressionOpt->expression[];
                         (if expression## <= loxcfl.Expression## then
                             expression[]->resolveExpression;
                         if)
                      #);
                 #);
            enter declaration[]
            do visitor[]->declaration.accept;
            #);
          resolveFunction:
            (# function: ^loxcfl.Function;
               parameters: ^loxcfl.Parameters;
               type: @integer;
               enclosingType: @integer;
               name: ^loxcfl.Name;
            enter (function[], type)
            do currentFunction -> enclosingType;
               type -> currentFunction;
               function.getName -> name[];
               name.getText->define;
               beginScope;
               function.getParameters->parameters[];
               parameters.newScan
                 (# 
                 do current.getText->define;
                 #);
               function.getBlock->resolveDeclaration;
               endScope;
               enclosingType -> currentFunction;
            #);
          resolveExpression:
            (# expression: ^loxcfl.Expression;
               visitor: @loxcfl.treeLevelVisitor
                 (# visit_Call:: 
                      (# 
                         accessVisitor: @loxcfl.treeLevelVisitor
                           (# visit_Method::
                                (# arguments: ^loxcfl.Arguments;
                                do N.getArguments->arguments[];
                                  arguments.newScan
                                    (# 
                                    do current[]->resolveExpression;
                                    #);
                                #);
                           #);
                      do N.getExpression->resolveExpression;
                         accessVisitor[] -> (N.getAccess).accept;
                      #);
                    visit_Assignment:: 
                      (# targetVisitor: @loxcfl.treeLevelVisitor
                           (# visit_Simple::
                                (# var: ^loxcfl.Variable;
                                do N.getVariable -> var[];
                                   var.getText -> resolveLocal -> var.distance;
                                #);
                              visit_Remote::
                                (#
                                do N.getExpression -> resolveExpression;
                                #);  
                           #);
                      do N.getExpression->resolveExpression;
                         targetVisitor[] -> (N.getTarget).accept;
                      #);
                    visit_Variable:: 
                      (# 
                      do N.getText ->  resolveLocal -> N.distance;
                      #);
                    visit_ThisExp::
                      (#
                      do 'this' ->  resolveLocal -> N.distance;
                      #);  
                    visit_Addition:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_Subtraction:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_Multiplication:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_Division:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_Grouping:: 
                      (# 
                      do N.getEvaluation->resolveExpression;
                      #);
                    visit_Equals:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_NotEquals:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_Less:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_LessEqual:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_Greater:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_GreaterEqual:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_LogicAnd:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_LogicOr:: 
                      (# 
                      do N.getLeftSide->resolveExpression;
                         N.getRightSide->resolveExpression;
                      #);
                    visit_Negation:: 
                      (# 
                      do N.getEvaluation->resolveExpression;
                      #);
                    visit_BoolNegation:: 
                      (# 
                      do N.getEvaluation->resolveExpression;
                      #);
                 #);
            enter expression[]
            do visitor[]->expression.accept;
            #);
       do functionTypes.main -> currentFunction;
          INNER
       #);
     ProgramResolver: Resolver
       (# program: ^loxcfl.Program;
       enter program[]
       do program[]->resolveProgram;
       #);
     Interpret:
       (# env: ^Environment;
          pushEnv:
            (# new: ^Environment
            do &Environment[]->new[];
               env[]->new.init;
               new[]->env[];
            #);
          popEnv:
            (# 
            do env.enclosing[]->env[];
            #);
          runtimeError:<
            (# node: ^AST;
               message: ^Text;
            enter (node[], message[])
            do INNER;
               message[]->screen.putLine;
               stop;
            #);
          semanticError:<
            (# node: ^AST;
               message: ^Text;
            enter (node[], message[])
            do INNER;
               (failureTrace, message[]) -> stop;
            #);
          onReturn:<
            (# value: ^LoxValue;
            enter value[]
            do INNER
            #);
          assertNumber:
            (# value: ^LoxValue;
               node: ^AST;
            enter (value[], node[])
            do (if not value.isNumber then
                   (node[], 'not a number')->runtimeError;
               if);
            #);
          assertBoolean:
            (# value: ^LoxValue;
               node: ^AST;
            enter (value[], node[])
            do (if not value.isBoolean then
                   (node[], 'not a boolean')->runtimeError;
               if);
            #);
          assertNonZero:
            (# value: @integer;
               node: ^AST;
            enter (value, node[])
            do (if value = 0 then
                   (node[], 'evaluated to zero')->runtimeError;
               if);
            #);
          ExecuteDeclarations:
            (# declarations: ^loxcfl.Declarations;
            enter declarations[]
            do declarations.newScan
                 (# 
                 do current[]->ExecuteDeclaration;
                 #);
            #);
          ExecuteDeclaration:
            (# declaration: ^loxcfl.Declaration;
               visitor: @loxcfl.treeLevelVisitor
                 (# visit_ExprStmt:: 
                      (# result: ^LoxValue;
                      do N.getExpression->Evaluate->result[];
                      #);
                    visit_PrintStmt:: 
                      (# result: ^LoxValue;
                      do N.getExpression->Evaluate->result[];
                         result.asString->screen.putText;
                      #);
                    visit_NewlineStmt:: 
                      (# 
                      do screen.newline;
                      #);
                    visit_VarDecl:: 
                      (# name: ^loxcfl.Name;
                         initializer: ^AST;
                         initialValue: ^LoxValue;
                         evaluator: @loxcfl.treeLevelVisitor
                           (# visit_Initializer:: 
                                (# 
                                do N.getExpression->Evaluate->initialValue[]
                                #);
                           #);
                      do N.getName->name[];
                         LoxNil[]->initialValue[];
                         N.getInitializerOpt->initializer[];
                         evaluator[]->initializer.accept;
                         (if not ((name.getText, initialValue[])->env.define) then
                             (N[], 'variable already defined')->runtimeError;
                         if);
                      #);
                    visit_FunDecl:: 
                      (# function: ^loxcfl.Function;
                         name: ^loxcfl.Name;
                         theLoxFunction: ^LoxFunction;
                      do N.getFunction->function[];
                         function.getName->name[];
                         &LoxFunction[]->theLoxFunction[];
                         name.getText->theLoxFunction.name[];
                         env[]->theLoxFunction.closure[];
                         function.getParameters->theLoxFunction.parameters[];
                         function.getBlock->theLoxFunction.block[];
                         (name.getText, theLoxFunction[])->env.define;
                      #);
                    visit_ClassDecl::
                      (# name: ^loxcfl.Name;
                         value: ^LoxClass;
                         functions: ^loxcfl.Functions;
                         methods: ^FunctionDictionary;
                      do N.getName->name[];
                         &LoxClass[] -> value[];
                         name.getText -> value.name[];
                         (if not ((name.getText, value[])->env.define) then
                             (N[], 'name already defined')->runtimeError;
                         if);
                         N.getFunctions -> functions[];
                         &FunctionDictionary[] -> methods[];
                         methods.init;
                         functions.newScan
                           (# name: ^loxcfl.Name;
                              method: ^LoxFunction;
                           do current.getName->name[];
                              &LoxFunction[]->method[];
                              name.getText->method.name[];
                              env[]->method.closure[];
                              current.getParameters->method.parameters[];
                              current.getBlock->method.block[];
                              (name.getText, method[]) -> methods.associate;
                           #);
                          methods[] -> value.methods[];
                      #);
                    visit_Block:: 
                      (# 
                      do pushEnv;
                         N.getDeclarations->ExecuteDeclarations;
                         popEnv;
                      #);
                    visit_IfStmt:: 
                      (# condition: ^LoxValue;
                         executor: @loxcfl.treeLevelVisitor
                           (# visit_ElsePart:: 
                                (# 
                                do N.getStatement->ExecuteDeclaration;
                                #);
                           #);
                      do N.getCondition->Evaluate->condition[];
                         (if condition.isTruthy then
                             N.getStatement->ExecuteDeclaration;
                          else
                             executor[]->(N.getElsePartOpt).accept;
                         if);
                      #);
                    visit_WhileStmt:: 
                      (# 
                      do loop:
                           (# condition: ^LoxValue;
                           do N.getCondition->Evaluate->condition[];
                              (if condition.isTruthy then
                                  N.getStatement->ExecuteDeclaration;
                                  restart loop;
                              if);
                           #);
                      #);
                    visit_ReturnStmt:: 
                      (# expression: ^AST;
                      do N.getExpressionOpt->expression[];
                         (if expression## <= loxcfl.Expression## then
                             expression[]->Evaluate->onReturn;
                          else
                             LoxNil[]->onReturn;
                         if);
                      #);
                 #);
            enter declaration[]
            do visitor[]->declaration.accept;
            #);
          Evaluate:
            (# expression: ^loxcfl.Expression;
               result: ^LoxValue;
               visitor: @loxcfl.treeLevelVisitor
                 (# Operation:
                      (# Type:< LoxValue;
                         result: ^Type;
                      do &Type[]->result[];
                         INNER;
                      exit result[]
                      #);
                    BinaryOperands: Operation
                      (# leftSide: ^loxcfl.Expression;
                         rightSide: ^loxcfl.Expression;
                         left: ^LoxValue;
                         right: ^LoxValue;
                      enter (leftSide[], rightSide[])
                      do leftSide[]->Evaluate->left[];
                         rightSide[]->Evaluate->right[];
                         (left[], leftSide[])->assertNumber;
                         (right[], rightSide[])->assertNumber;
                         INNER;
                      #);
                    BinaryMath: BinaryOperands
                      (# Type:: LoxNumber;
                      do INNER;
                      #);
                    Add: BinaryMath
                      (# 
                      do left.asNumber+right.asNumber->result.value
                      #);
                    Subtract: BinaryMath
                      (# 
                      do left.asNumber-right.asNumber->result.value
                      #);
                    Multiply: BinaryMath
                      (# 
                      do left.asNumber*right.asNumber->result.value
                      #);
                    Divide: BinaryMath
                      (# 
                      do (right.asNumber, rightSide[])->assertNonZero;
                         left.asNumber / right.asNumber->result.value;
                      #);
                    Comparison: BinaryOperands
                      (# Type:: LoxBoolean;
                      do INNER;
                      #);
                    Less: Comparison
                      (# 
                      do left.asNumber < right.asNumber->result.value;
                      #);
                    LessEqual: Comparison
                      (# 
                      do left.asNumber <= right.asNumber->result.value;
                      #);
                    Greater: Comparison
                      (# 
                      do left.asNumber > right.asNumber->result.value;
                      #);
                    GreaterEqual: Comparison
                      (# 
                      do left.asNumber >= right.asNumber->result.value;
                      #);
                    Equal: Comparison
                      (# 
                      do left.asNumber = right.asNumber->result.value;
                      #);
                    NotEqual: Comparison
                      (# 
                      do left.asNumber <> right.asNumber->result.value;
                      #);
                    AndOperation: Operation
                      (# Type:: LoxBoolean;
                         leftSide: ^loxcfl.Expression;
                         rightSide: ^loxcfl.Expression;
                         left: ^LoxValue;
                         right: ^LoxValue;
                      enter (leftSide[], rightSide[])
                      do leftSide[]->Evaluate->left[];
                         (if left.isTruthy then
                             rightSide[]->Evaluate->right[];
                             right.isTruthy->result.value;
                          else
                             false->result.value;
                         if);
                      #);
                    OrOperation: Operation
                      (# leftSide: ^loxcfl.Expression;
                         rightSide: ^loxcfl.Expression;
                         left: ^LoxValue;
                         right: ^LoxValue;
                      enter (leftSide[], rightSide[])
                      do leftSide[]->Evaluate->left[];
                         (if left.isTruthy then
                             left[]->result[];
                             leave OrOperation;
                         if);
                         rightSide[]->Evaluate->right[];
                         (if right.isTruthy then
                             right[]->result[];
                             leave OrOperation;
                         if);
                         &LoxBoolean[]->result[];
                      #);
                    NegateOperation: Operation
                      (# Type:: LoxNumber;
                         theExpression: ^loxcfl.Expression;
                         value: ^LoxValue;
                      enter theExpression[]
                      do theExpression[]->Evaluate->value[];
                         (value[], theExpression[])->assertNumber;
                         - value.asNumber->result.value;
                      #);
                    BoolNegateOperation: Operation
                      (# Type:: LoxBoolean;
                         theExpression: ^loxcfl.Expression;
                         value: ^LoxValue;
                      enter theExpression[]
                      do theExpression[]->Evaluate->value[];
                         not value.isTruthy->result.value;
                      #);
                    visit_Call:: 
                      (# value: ^LoxValue;
                         accessVisitor: @loxcfl.treeLevelVisitor
                           (# visit_Method::
                                (# callable: ^LoxCallable;
                                   args: ^ArgumentList;
                                   arguments: ^loxcfl.Arguments;
                                do (if value.isCallable then
                                      value.asCallable->callable[];
                                      &ArgumentList[]->args[];
                                      N.getArguments->arguments[];
                                      arguments.newScan
                                        (# 
                                        do current[]->Evaluate->args.insertBack;
                                        #);
                                      (if args.size <> callable.arity then
                                          (N[], 'arity error')->runtimeError;
                                      if);
                                      args[]->callable.call->result[];
                                  if);
                                #);
                              visit_Property::
                                (# instance: ^LoxInstance;
                                do (if value.isInstance then
                                       value.asInstance -> instance[];
                                       N.getText -> instance.get -> result[];
                                   if)
                                #);  
                           #);
                         access: ^loxcfl.Access;
                      do N.getExpression->Evaluate->value[];
                         N.getAccess -> access[];
                         accessVisitor[] -> access.accept;
                      #);
                    visit_Assignment:: 
                      (# name: ^loxcfl.Variable;
                         targetVisitor: @loxcfl.treeLevelVisitor
                           (# visit_Simple::
                                (#
                                do  N.getVariable->name[];
                                    (if not ((name.getText, result[])->env.assign) then
                                        (N[], 'variable does not exist')->runtimeError;
                                    if);
                                #);
                              visit_Remote::
                                (# value: ^LoxValue;
                                   property: ^loxcfl.Property;
                                do N.getExpression->Evaluate->value[]; 
                                   (if value.isInstance then
                                       N.getProperty -> property[];
                                       (property.getText, result[]) -> (value.asInstance).assign;
                                   else
                                      (N[], 'object required') -> runtimeError;
                                   if)
                                #);
                           #);
                      do N.getExpression->Evaluate->result[];
                         targetVisitor[] -> (N.getTarget).accept;
                      #);
                    visit_Variable:: 
                      (# 
                      do (if N.distance = -1 then
                             N.getText -> globals.get -> result[];
                          else
                             (N.getText, N.distance)->env.getAt->result[];
                         if);
                         (if result[] = none then
                             (N[], 'variable does not exist')->runtimeError;
                         if);
                      #);
                    visit_ThisExp::
                      (#
                      do ('this', N.distance) -> env.getAt -> result[];
                      #);  
                    visit_Number:: 
                      (# input: ^Text;
                         theNumber: @LoxNumber;
                         theConst: ^Const;
                      do N.getConst->theConst[];
                         theConst.getText->input[];
                         input.reset;
                         input.getNumber
                           (# integerValue:: 
                                (# 
                                do value->theNumber.value;
                                #);
                              basedValue:: 
                                (# 
                                do value->theNumber.value;
                                #);
                              realValue:: 
                                (# 
                                do value->theNumber.value;
                                #);
                           #);
                         theNumber[]->result[];
                      #);
                    visit_TrueExp:: 
                      (# theBoolean: @LoxBoolean;
                      do true->theBoolean.value;
                         theBoolean[]->result[];
                      #);
                    visit_FalseExp:: 
                      (# theBoolean: @LoxBoolean;
                      do false->theBoolean.value;
                         theBoolean[]->result[];
                      #);
                    visit_Addition:: 
                      (# left: ^LoxValue;
                         right: ^LoxValue;
                         stringResult: ^LoxString;
                         numberResult: ^LoxNumber;
                      do N.getLeftSide -> Evaluate -> left[];
                         (if true
                          // left.isNumber then
                             N.getRightSide -> Evaluate -> right[];
                             (right[], N[]) -> assertNumber;
                             &LoxNumber[] -> numberResult[];
                             left.asNumber + right.asNumber -> numberResult.value;
                             numberResult[] -> result[];
                          // left.isString then
                             N.getRightSide -> Evaluate -> right[];
                             &LoxString[] -> stringResult[];
                             &Text[] -> stringResult.value[];
                            left.asString -> stringResult.value.putText;
                            right.asString -> stringResult.value.putText;
                            stringResult[] -> result[];
                          else
                             (N[], 'number or string required') -> runtimeError;
                         if);
                      #);
                    visit_Subtraction:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Subtract->result[];
                      #);
                    visit_Multiplication:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Multiply->result[];
                      #);
                    visit_Division:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Divide->result[];
                      #);
                    visit_Grouping:: 
                      (# 
                      do N.getEvaluation->evaluate->result[];
                      #);
                    visit_Equals:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Equal->result[];
                      #);
                    visit_NotEquals:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->NotEqual->result[];
                      #);
                    visit_Less:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Less->result[];
                      #);
                    visit_LessEqual:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->LessEqual->result[];
                      #);
                    visit_Greater:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->Greater->result[];
                      #);
                    visit_GreaterEqual:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->GreaterEqual->result[];
                      #);
                    visit_LogicAnd:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->AndOperation->result[];
                      #);
                    visit_LogicOr:: 
                      (# 
                      do (N.getLeftSide, N.getRightSide)->OrOperation->result[];
                      #);
                    visit_Negation:: 
                      (# 
                      do N.getEvaluation->NegateOperation->result[];
                      #);
                    visit_BoolNegation:: 
                      (# 
                      do N.getEvaluation->BoolNegateOperation->result[];
                      #);
                    visit_Text:: 
                      (# str: ^String;
                         theLoxString: @LoxString;
                      do N.getString->str[];
                         str.getText->theLoxString.value[];
                         theLoxString[]->result[];
                      #);
                    visit_NilExp:: 
                      (# 
                      do LoxNil[]->result[];
                      #);
                 #);
            enter expression[]
            do visitor[]->expression.accept;
            exit result[]
            #);
       enter env[]
       do INNER;
       #);
     InterpretExpression: Interpret
       (# expression: ^loxcfl.Expression;
          result: ^LoxValue;
       enter expression[]
       do expression[]->Evaluate->result[];
       exit result[]
       #);
     InterpretProgram: Interpret
       (# program: ^loxcfl.Program;
       enter program[]
       do program[]->ProgramResolver
            (# error::
                 (#
                 do (node[], message[]) -> semanticError;
                 #);
            #);
          program.getDeclarations->ExecuteDeclarations;
       #);
     InterpretStatement: Interpret
       (# declaration: ^loxcfl.Declaration;
       enter declaration[]
       do declaration[]->ExecuteDeclaration;
       #)
  do 'grammar/lox-parser'->loxcfl.init;
     &Environment[]->globals[];
     globals.init;
     ('clock', &Clock[])->globals.define;
     INNER;
  #);

